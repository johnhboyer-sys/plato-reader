---
// A work's landing page, served at the bare /<work> slug. An overview that
// describes the work, credits the Greek source + translations, lists the
// table of contents (linking into the reader), surfaces the "start reading"
// editions, and points to in-print modern translations/commentaries we can't
// host. The reader itself lives at /<work>/book/<n> for every work.
import { readFileSync } from 'node:fs';
import ThemeInit from './ThemeInit.astro';
import SiteNav from './SiteNav.astro';
import Inscription from './Inscription.astro';
import Pwa from './Pwa.astro';
import Fonts from './Fonts.astro';
import CommandPalette from '@shared/components/CommandPalette.svelte';
import {
  AUTHENTICITY_LABEL, SHELVES, getWork, bookLabel, isBookless, workPath, visibleTranslations,
  furtherReading, inPrintHref, workLanding, resourcesFor, partOutline,
} from '@shared/lib/works';
import { assignSpeakerSlots, collectDisplayOrder } from '@shared/lib/speaker-colors';
import { greekNumeral } from '@shared/lib/numerals';
import { inscriptionCaps } from '@shared/lib/inscription';
import { sanitizeHtml } from '../lib/html';
import { jsonLdSafe } from '../lib/jsonld';
import '@shared/styles/global.css';

interface Props { workId: string; }
const { workId } = Astro.props as Props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const work = getWork(workId)!;
const bookless = isBookless(work);
// Stephanus works (Plato) have no chapters.json — stage7 emits sections.json
// (a per-page outline) instead (see manifests/Euthyphro.yaml). Mirrors
// ReaderShell.astro's `stephanus`/`pagesOf` handling.
const stephanus = work.citation?.scheme === 'stephanus';
const citeWord = stephanus ? 'Stephanus' : (work.citation?.scheme === 'busse' ? 'page' : 'Bekker');

interface ChapterRef { chapter: string; column: string; line: string; bekker: string; }
interface SectionRef { column: string; page: number; letter: string; id: string; }
let allChapters: Record<string, ChapterRef[]> = {};
let allSections: Record<string, SectionRef[]> = {};
if (stephanus) {
  try {
    allSections = JSON.parse(readFileSync(`public/data/${workId}/sections.json`, 'utf-8'));
  } catch { /* no sections yet */ }
} else {
  allChapters = JSON.parse(readFileSync(`public/data/${workId}/chapters.json`, 'utf-8'));
}
// Dramatis personae — the speakers in this dialogue, read from each book's
// turnFlow. Coloured with the reader's own palette (shared/lib/speaker-colors,
// keyed by the printed display like the reader) so a speaker's hue matches
// between this cast list and the text. Collected in first-appearance order,
// across every book; shown only when the work has two or more named speakers.
interface CastMember { name: string; abbr: string; slot: number; }
let cast: CastMember[] = [];
// The work's opening words for the head's inscription grid, from book 1's
// first sections, and where they stand ("Rep. 327a").
let opening = '';
let openingRef = '';
{
  // Top-level turn owners in first-appearance order — the cast we display.
  const owners: { s: string; d: string }[] = [];
  const ownerSeen = new Set<string>();
  // Each book's turn flow, kept so the colour roster is built with the SAME
  // collectDisplayOrder(whole work) call ReaderShell.astro uses — guaranteeing a
  // speaker's cast colour matches its colour in every book of the reader.
  type Flow = Parameters<typeof collectDisplayOrder>[0] extends Iterable<infer F> ? F : never;
  const flows: Flow[] = [];
  let para = false;
  for (let b = 1; b <= work.books; b++) {
    let bd: { turnFlow?: { kind?: string; turns?: Array<{ s: string | null; d: string | null;
      et?: Array<{ d: string | null }> | null }> };
      segments?: Array<{ column: string; greek: Array<{ text: string }> }> };
    try {
      bd = JSON.parse(readFileSync(`public/data/${workId}/book-${String(b).padStart(2, '0')}.json`, 'utf-8'));
    } catch { continue; }
    if (b === 1 && bd.segments?.length) {
      openingRef = `${work.abbr} ${bd.segments[0].column}`;
      opening = bd.segments.slice(0, 3).flatMap((sg) => sg.greek.map((l) => l.text)).join(' ');
    }
    flows.push(bd.turnFlow as Flow);
    if (bd.turnFlow?.kind === 'para') para = true;
    for (const t of bd.turnFlow?.turns ?? []) {
      if (t.s && t.d && !ownerSeen.has(t.s)) { ownerSeen.add(t.s); owners.push({ s: t.s, d: t.d }); }
    }
  }
  // Only DIRECT dialogues get a cast: the top-level turns must be the actual
  // speakers. Reported dialogues (works.ts `narrator`: Phaedo, Symposium,
  // Euthydemus, Protagoras, Lysis, Parmenides) and paragraph-narrated works
  // (Republic) recount their dialogue inside the frame, so their top-level
  // turns are only the frame — suppress rather than show a misleading cast.
  // (Surfacing the inner speakers of narrated works is deferred editorial
  // work.) The flag, not a share of `sub` rows: Euthydemus sat at 0.48–0.51
  // and flipped with any change to turn pairing.
  if (owners.length >= 2 && !work.narrator && !para) {
    const slots = assignSpeakerSlots(collectDisplayOrder(flows));
    cast = owners.map((o) => ({ name: o.s, abbr: o.d, slot: slots.get(o.d) ?? 0 }));
  }
}

// The Stephanus pages of a book: the first section column on each page, in
// reading order (mirrors ReaderShell.astro's `pagesOf`).
const pagesOf = (b: number): { page: number; column: string }[] => {
  const secs = allSections[String(b)] ?? [];
  const out: { page: number; column: string }[] = [];
  let last: number | null = null;
  for (const s of secs) {
    if (s.page !== last) { out.push({ page: s.page, column: s.column }); last = s.page; }
  }
  return out;
};
interface BookOutline {
  book: number; label: string; chapters: ChapterRef[]; pages: { page: number; column: string }[];
}
const outline: BookOutline[] = Array.from({ length: work.books }, (_, i) => {
  const b = i + 1;
  return {
    book: b, label: bookLabel(work, b),
    chapters: allChapters[String(b)] ?? [],
    pages: stephanus ? pagesOf(b) : [],
  };
});
const totalChapters = stephanus
  ? outline.reduce((n, b) => n + b.pages.length, 0)
  : outline.reduce((n, b) => n + b.chapters.length, 0);
// A book's span under its numeral: "327a–354c" (the first and last Stephanus
// section of the book; Bekker for a bekker work).
const bookSpan = (b: BookOutline) => {
  if (stephanus) {
    const secs = allSections[String(b.book)] ?? [];
    const first = secs[0]?.column ?? '';
    const last = secs.at(-1)?.column ?? '';
    return first && last ? `${first}–${last}` : '';
  }
  const first = b.chapters[0]?.bekker.split('–')[0] ?? '';
  const last = b.chapters.at(-1)?.bekker.split('–').at(-1) ?? '';
  return first && last ? `${first}–${last}` : '';
};
// The whole work's span for the facts: first book's start to last book's end.
const workSpan = [bookSpan(outline[0]).split('–')[0], bookSpan(outline[outline.length - 1]).split('–').at(-1)]
  .filter(Boolean).join('–');
// The theme (home-page shelf) the work stands under, for the head's eyebrow.
const shelf = SHELVES.find((sh) => sh.works.some((w) => w.id === workId));

const editions = visibleTranslations(work);
const primary = editions.find((t) => t.id === work.defaultTranslation)
  ?? editions.find((t) => t.slot === 'english') ?? editions[0];
const translatorNames = editions.map((t) => t.name.split(' (')[0]);
const commentaries = (work.commentaries ?? [])
  .map((id) => getWork(id))
  .filter((w): w is NonNullable<typeof w> => Boolean(w));
const resources = resourcesFor(workId);
const reading = furtherReading(workId);
const readingTrans = reading.filter((r) => r.kind === 'translation');
const readingComm = reading.filter((r) => r.kind === 'commentary');
const readingColl = reading.filter((r) => r.kind === 'collection');

const readHref = (q = '') => `${base}${workPath(workId, 1)}${q}`;

// Named parts of a single-book work (the Letters), listed where a multi-book
// work lists its books. Each links into the reader at the part's first section.
const parts = bookless && stephanus ? partOutline(work, allSections['1'] ?? []) : [];
const partsHeading = parts.length && parts.every((p) => p.label.startsWith('Letter')) ? 'Letters' : 'Parts';

// ── SEO ─────────────────────────────────────────────────────────────────────
const pageTitle = `${work.title} — ${work.author}, in Greek & English`;
const metaDescription =
  `${work.title} by ${work.author}: the original Greek (${work.greekSource.short})` +
  ` with English translation` +
  (translatorNames.length ? ` (${translatorNames.join(', ')})` : '') +
  `, table of contents, morphology, and ${citeWord} citation. ${work.blurb}`;
const canonical = Astro.site
  ? new URL(`${base}${workPath(workId, 1).replace(/\/book\/1$/, '')}/`, Astro.site).href
  : undefined;
const ogImage = Astro.site
  ? new URL(`${base}/og-default.png`, Astro.site).href : undefined;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  name: work.title,
  ...(work.greekTitle ? { alternateName: work.greekTitle } : {}),
  author: { '@type': 'Person', name: work.author },
  ...(translatorNames.length
    ? { translator: translatorNames.map((name) => ({ '@type': 'Person', name })) }
    : {}),
  inLanguage: ['grc', 'en'],
  ...(canonical ? { url: canonical } : {}),
  numberOfPages: totalChapters,
  isPartOf: { '@type': 'CreativeWorkSeries', name: `The Works of ${work.author}` },
  description: work.blurb,
};
// Breadcrumb (Home › Work) for a SERP breadcrumb rich result. Absolute URLs
// required, so emitted only when Astro.site is set.
const breadcrumbLd = Astro.site
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'The Plato Reader',
          item: new URL(`${base}/`, Astro.site).href },
        { '@type': 'ListItem', position: 2, name: work.title,
          item: new URL(`${base}${workLanding(workId)}/`, Astro.site).href },
      ],
    }
  : null;
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ThemeInit />
  <title>{pageTitle}</title>
  <meta name="description" content={metaDescription} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="book" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={metaDescription} />
  {canonical && <meta property="og:url" content={canonical} />}
  <meta property="og:site_name" content="The Plato Reader" />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={metaDescription} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  <script type="application/ld+json" set:html={jsonLdSafe(jsonLd)} />
  {breadcrumbLd && <script type="application/ld+json" set:html={jsonLdSafe(breadcrumbLd)} />}
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="icon" href={`${base}/favicon.png`} type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} sizes="180x180" />
  <Fonts />
  <style>
    .lp { max-width: 1280px; margin: 0 auto; padding: 0 3.5rem 5rem; font-family: var(--font-english); color: var(--text); }
    .caps, .lp-eyebrow, .lp-ref, .lp-facts dt, h2.lp-h, .lp-btn, .bk-r small, .rk, .ed-kind, .cast-abbr {
      font-family: var(--font-caps);
      font-weight: 300;
      letter-spacing: var(--caps-tracking);
      text-transform: uppercase;
    }

    /* The head: the work's opening words cut in the grid (fading out), then
       the title in spaced capitals, the English title, the blurb, the facts
       and the ways in. */
    .lp-head {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      gap: 4rem;
      padding: 3.5rem 0 0.5rem;
    }
    .lp-inscr { --cell-w: 2.5rem; --cell-h: 3rem; --cell-fs: 2.375rem; }
    .lp-ref { margin: 0.4rem 0 0; font-size: 0.75rem; color: var(--accent); }
    .lp-eyebrow { margin: 0; font-size: 0.75rem; color: var(--text-mid); }
    .lp-dub { margin-left: 0.9rem; color: var(--accent-2); }
    .lp-gr {
      margin: 0.4rem 0 0.6rem;
      font-family: var(--font-caps);
      font-weight: 300;
      font-size: 3.625rem;
      line-height: 1.05;
      letter-spacing: 0.2em;
      overflow-wrap: anywhere;
    }
    h1.lp-en {
      margin: 0 0 1.125rem;
      font-family: var(--font-english);
      font-style: italic;
      font-weight: 400;
      font-size: 2.375rem;
      line-height: 1.1;
    }
    .lp-lede { margin: 0; max-width: 40em; font-size: 1.1875rem; line-height: 1.55; }
    .lp-facts {
      display: grid;
      grid-template-columns: 9.4rem minmax(0, 1fr);
      gap: 0.5rem 1.125rem;
      margin: 1.5rem 0 0;
      font-size: 1.0625rem;
      line-height: 1.45;
    }
    .lp-facts dt { padding-top: 0.25rem; font-size: 0.6875rem; color: var(--text-mid); }
    .lp-facts dd { margin: 0; }
    .lp-cta-row { display: flex; flex-wrap: wrap; gap: 0.875rem; margin-top: 1.75rem; }
    .lp-btn[hidden] { display: none; }
    .lp-btn {
      display: inline-flex;
      align-items: center;
      padding: 0.875rem 1.375rem;
      font-size: 0.8125rem;
      color: var(--text);
      text-decoration: none;
      border: 1px solid var(--text);
      background: none;
    }
    .lp-btn:hover { color: var(--accent); border-color: var(--accent); }
    .lp-btn.primary { background: var(--text); color: var(--page-bg); }
    .lp-btn.primary:hover { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
    .lp-btn:focus-visible { outline: 2px solid var(--accent-light); outline-offset: 2px; }
    .lp-related { margin: 1.25rem 0 0; font-size: 1rem; color: var(--text-mid); }
    .lp-related a, .credits a, .read-list a.buy, .read-list a.res-link {
      color: var(--text);
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 0.2em;
    }
    .lp-related a:hover, .credits a:hover, .read-list a:hover { color: var(--accent); }

    /* Sections under the head: a blue capital label over an ink rule. */
    .lp-sec { margin-top: 2.5rem; }
    h2.lp-h {
      margin: 0 0 1rem;
      padding-top: 0.9rem;
      border-top: 1px solid var(--text);
      font-size: 0.75rem;
      color: var(--accent);
    }

    /* Books (or the Letters) by Greek numeral, five to a row. */
    .book-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); column-gap: 1.5rem; }
    .book-list a {
      display: grid;
      grid-template-columns: 3.25rem minmax(0, 1fr);
      align-items: baseline;
      padding: 0.875rem 0;
      border-bottom: 1px solid var(--border);
      color: var(--text);
      text-decoration: none;
    }
    .bk-n { font-family: var(--font-caps); font-weight: 300; font-size: 2.125rem; line-height: 1; color: var(--accent); }
    .bk-r { font-size: 1.0625rem; }
    .bk-r small { display: block; margin-top: 0.15rem; font-size: 0.6875rem; letter-spacing: 0.12em; color: var(--text-mid); font-variant-numeric: tabular-nums; }
    .book-list a:hover .bk-r { color: var(--accent); }

    /* Dramatis personae — each speaker in spaced capitals, in the hue the
       reader gives their name. data-spk resolves to one of the shared
       --spk-* palette vars (global.css). */
    .cast-list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.6rem 2rem; }
    .cast-item { display: inline-flex; align-items: baseline; gap: 0.6rem; }
    .cast-name { font-family: var(--font-caps); font-weight: 400; font-size: 0.9375rem; letter-spacing: var(--caps-tracking); text-transform: uppercase; color: var(--c, var(--text)); }
    .cast-abbr { font-size: 0.6875rem; color: var(--text-mid); }
    .cast-item[data-spk="0"] { --c: var(--spk-0); }
    .cast-item[data-spk="1"] { --c: var(--spk-1); }
    .cast-item[data-spk="2"] { --c: var(--spk-2); }
    .cast-item[data-spk="3"] { --c: var(--spk-3); }
    .cast-item[data-spk="4"] { --c: var(--spk-4); }
    .cast-item[data-spk="5"] { --c: var(--spk-5); }
    .cast-item[data-spk="6"] { --c: var(--spk-6); }
    .cast-item[data-spk="7"] { --c: var(--spk-7); }

    /* Translations to read, and commentaries: ruled rows. */
    .ed-list, .read-list { list-style: none; padding: 0; margin: 0; }
    .ed-list a {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 1rem;
      padding: 0.8rem 0;
      border-bottom: 1px solid var(--border);
      color: var(--text);
      text-decoration: none;
    }
    .ed-list li:first-child a { padding-top: 0.2rem; }
    .ed-name { font-size: 1.1875rem; }
    .ed-kind { font-size: 0.6875rem; color: var(--text-mid); text-align: right; }
    .ed-list a:hover .ed-name { color: var(--accent); }
    .comm-card { flex-direction: column; align-items: flex-start; gap: 0.4rem; }
    .comm-title { font-size: 1.1875rem; }
    .comm-greek { color: var(--text-mid); }
    .comm-blurb { font-size: 1rem; line-height: 1.5; color: var(--text-mid); }
    .comm-cta { font-size: 1rem; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
    .comm-card:hover .comm-cta { color: var(--accent); }
    .credits { margin: 0; font-size: 1.0625rem; line-height: 1.65; color: var(--text-mid); }
    .credits strong { font-weight: 400; color: var(--text); }
    .read-list li { margin: 0 0 0.75rem; font-size: 1.0625rem; line-height: 1.55; color: var(--text-mid); }
    .read-list .rk { margin-right: 0.6em; font-size: 0.6875rem; color: var(--accent); }
    .read-list a.buy { white-space: nowrap; }
    .lp-note { margin-top: 0.8rem; font-size: 0.95rem; color: var(--text-mid); }

    @media (max-width: 1100px) {
      .lp { padding: 0 2rem 4rem; }
      .lp-head { gap: 2.5rem; }
      .lp-inscr { --cell-w: 2.1rem; --cell-h: 2.55rem; --cell-fs: 2rem; }
      .book-list { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    }
    @media (max-width: 900px) {
      .lp-head { grid-template-columns: minmax(0, 1fr); gap: 1.75rem; padding-top: 2.5rem; }
      .book-list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }
    @media (max-width: 680px) {
      .lp { padding: 0 1.25rem 3rem; }
      .lp-head { padding-top: 1rem; gap: 1.25rem; }
      .lp-inscr { --cell-w: 1fr; --cell-h: 1.625rem; --cell-fs: 1.1875rem; }
      .lp-gr { font-size: 2.125rem; letter-spacing: 0.18em; }
      h1.lp-en { font-size: 1.875rem; line-height: 1.15; }
      .lp-lede { font-size: 1rem; }
      .lp-facts { grid-template-columns: 6rem minmax(0, 1fr); gap: 0.4rem 0.75rem; font-size: 0.875rem; }
      .lp-facts dt { font-size: 0.625rem; }
      .lp-cta-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.625rem; }
      .lp-btn { justify-content: center; padding: 0.8rem 0.5rem; font-size: 0.75rem; }
      .book-list { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 1rem; }
      .bk-n { font-size: 1.5rem; }
      .book-list a { grid-template-columns: 2rem minmax(0, 1fr); padding: 0.625rem 0; }
      .ed-list a { flex-direction: column; gap: 0.2rem; }
      .ed-kind { text-align: left; }
    }
  </style>
  <Pwa />
</head>
<body class="landing">
  <CommandPalette work={workId} client:load />
  <SiteNav />

  <main class="lp">
    <section class="lp-head">
      {opening && (
        <div class="lp-inscr">
          <Inscription text={opening} cols={12} rows={4} fade />
          <p class="lp-ref">{openingRef}</p>
        </div>
      )}
      <div class="lp-intro">
        <p class="lp-eyebrow">
          {shelf ? `${greekNumeral(Number(shelf.numeral))} · ${shelf.title}` : work.author}
          {work.authenticity && work.authenticity !== 'genuine' && (
            <span class="lp-dub">{AUTHENTICITY_LABEL[work.authenticity]}</span>
          )}
        </p>
        <p class="lp-gr" lang="grc">{inscriptionCaps(work.greekTitle ?? work.title)}</p>
        <h1 class="lp-en">{work.title}</h1>
        <p class="lp-lede">{work.blurb}</p>
        <dl class="lp-facts">
          <dt>Greek</dt><dd>{work.greekSource.full}</dd>
          {editions.length > 0 && (<><dt>English</dt><dd>{editions.map((t) => t.name).join('; ')}</dd></>)}
          <dt>{citeWord}</dt><dd>{workSpan}{bookless ? '' : ` · ${work.books} books`} · {totalChapters} {stephanus ? 'page' : 'chapter'}{totalChapters === 1 ? '' : 's'}</dd>
          {work.period && (<><dt>Dating</dt><dd>Traditionally dated to Plato’s {work.period} period.</dd></>)}
          {work.authenticity && work.authenticity !== 'genuine' && (
            <><dt>Authorship</dt><dd>Traditionally doubted — transmitted with {work.author}’s works but widely judged not to be by {work.author}.</dd></>
          )}
        </dl>
        <div class="lp-cta-row">
          <a class="lp-btn primary" href={primary ? readHref(`?trans=${primary.id}`) : readHref()}>Start reading</a>
          <a class="lp-btn resume-btn" id="lp-resume" href="#" hidden
             data-work={workId} data-books={work.books}>Resume</a>
          <a class="lp-btn" href={readHref('?view=greek')}>Greek only</a>
          {editions.length > 1 && <a class="lp-btn" href={readHref('?trans=compare')}>Compare translations</a>}
        </div>
        {work.related && work.related.length > 0 && (
          <p class="lp-related">
            See also: {work.related.map((r, i) => {
              const rw = getWork(r.id);
              return rw ? (
                <>
                  {i > 0 && <span> · </span>}
                  <a href={`${base}${workLanding(r.id)}`}>{r.label}</a>
                </>
              ) : null;
            })}
          </p>
        )}
      </div>
    </section>

    {!bookless && (
      <section class="lp-sec">
        <h2 class="lp-h">Books</h2>
        <ul class="book-list">
          {outline.map((b) => (
            <li>
              <a href={`${base}${workPath(workId, b.book)}`}>
                <span class="bk-n" aria-hidden="true">{greekNumeral(b.book)}</span>
                <span class="bk-r">Book {b.label}<small>{bookSpan(b)}</small></span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {bookless && parts.length > 0 && (
      <section class="lp-sec">
        <h2 class="lp-h">{partsHeading}</h2>
        <ul class="book-list">
          {parts.map((p, i) => (
            <li>
              <a href={readHref(`?loc=${p.start}`)}>
                <span class="bk-n" aria-hidden="true">{greekNumeral(i + 1)}</span>
                <span class="bk-r">{p.label}<small>{p.start === p.end ? p.start : `${p.start}–${p.end}`}</small></span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {cast.length > 1 && (
      <section class="lp-sec lp-cast" aria-label="Speakers in this dialogue">
        <h2 class="lp-h">Speakers</h2>
        <ul class="cast-list">
          {cast.map((m) => (
            <li class="cast-item" data-spk={m.slot}>
              <span class="cast-name">{m.name}</span>
              {m.abbr !== m.name && <span class="cast-abbr">{m.abbr}</span>}
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="lp-sec">
      <h2 class="lp-h">Read this work</h2>
      <ul class="ed-list">
        {editions.map((t) => (
          <li>
            <a href={readHref(`?trans=${t.id}`)}>
              <span class="ed-name">{t.short}</span>
              <span class="ed-kind">Greek &amp; English · {t.name}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    {commentaries.length > 0 && (
      <section class="lp-sec">
        <h2 class="lp-h">Commentary</h2>
        <ul class="ed-list">
          {commentaries.map((c) => (
            <li>
              <a class="comm-card" href={`${base}${workLanding(c.id)}`}>
                <span class="comm-title">{c.author} — {c.title}{c.greekTitle && <span class="comm-greek"> · {c.greekTitle}</span>}</span>
                <span class="comm-blurb">{c.blurb}</span>
                <span class="comm-cta">Read the {c.title} →</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="lp-sec">
      <h2 class="lp-h">Greek text &amp; translations</h2>
      <p class="credits">
        <strong>Greek:</strong> {work.greekSource.full}<br />
        <strong>{translatorNames.length > 1 ? 'Translations' : 'Translation'}:</strong>
        {' '}{editions.map((t) => t.name).join('; ')}.<br />
        Full source and licence details are on the
        <a href={`${base}/attribution`}>Texts &amp; Licences</a> page.
      </p>
    </section>

    {reading.length > 0 && (
      <section class="lp-sec">
        <h2 class="lp-h">In print</h2>
        {(readingTrans.length > 0 || readingComm.length > 0) && (
          <>
            <p class="credits" style="margin-bottom:0.8rem;">
              Modern, copyright-protected translations and commentaries we can’t
              host here, for readers who want to go further:
            </p>
            <ul class="read-list">
              {readingTrans.map((r) => (
                <li>
                  <span class="rk">Translation</span><span set:html={sanitizeHtml(r.cite)} />{' '}
                  <a class="buy" href={inPrintHref(r)} target="_blank" rel="noopener nofollow">Find in print →</a>
                </li>
              ))}
              {readingComm.map((r) => (
                <li>
                  <span class="rk">Commentary</span><span set:html={sanitizeHtml(r.cite)} />{' '}
                  <a class="buy" href={inPrintHref(r)} target="_blank" rel="noopener nofollow">Find in print →</a>
                </li>
              ))}
            </ul>
          </>
        )}
        {readingColl.length > 0 && (
          <>
            <p class="credits" style="margin:1rem 0 0.8rem;">
              Prefer a paper copy? These in-print editions carry the translation
              read here (or a revision of it):
            </p>
            <ul class="read-list">
              {readingColl.map((r) => (
                <li>
                  <span class="rk">In print</span><span set:html={sanitizeHtml(r.cite)} />{' '}
                  <a class="buy" href={inPrintHref(r)} target="_blank" rel="noopener nofollow">Find in print →</a>
                </li>
              ))}
            </ul>
          </>
        )}
        <p class="lp-note">“Find in print” opens a Google Books search for the edition.</p>
      </section>
    )}

    {resources.length > 0 && (
      <section class="lp-sec">
        <h2 class="lp-h">Resources</h2>
        <ul class="read-list">
          {resources.map((r) => (
            <li>
              <a class="res-link" href={r.url} target="_blank" rel="noopener">{r.label}</a>
              {' — '}{r.blurb}
              {r.exercises && <> See {r.exercises}, relevant to this work.</>}
              {' '}Developed by{' '}
              <a class="buy" href={r.authorUrl} target="_blank" rel="noopener">{r.authorName}</a>.
            </li>
          ))}
        </ul>
      </section>
    )}
  </main>
<script>
  // "Resume" CTA: appears when the reader has a saved position for this work
  // (localStorage — see shared/lib/resume.ts), linking to the remembered
  // book + Bekker citation.
  import { resumeFor } from '@shared/lib/resume';

  const btn = document.getElementById('lp-resume') as HTMLAnchorElement | null;
  if (btn) {
    const pos = resumeFor(btn.dataset.work!);
    if (pos) {
      const books = Number(btn.dataset.books) || 1;
      const book = Math.min(Math.max(1, pos.book), books);
      const base = (import.meta.env.BASE_URL as string).replace(/\/$/, '');
      btn.href = `${base}/${btn.dataset.work}/book/${book}${pos.cite ? `#${pos.cite}` : ''}`;
      btn.textContent = pos.cite ? `Resume at ${pos.cite}` : (books > 1 ? `Resume Book ${book}` : 'Resume');
      btn.hidden = false;
    }
  }
</script>
</body>
</html>
