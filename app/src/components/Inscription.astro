---
// The stoichedon grid: Greek capitals in fixed cells, no word spaces, aligned
// down the columns as on an Attic inscription — the redesign's only art. Drawn
// in markup, one letter per cell, and hidden from screen readers: the page
// carries the real title in its <h1>.
//
// The caller sizes it through custom properties on its own wrapper:
// --cell-w, --cell-h and --cell-fs (cell width, row height, letter size).
import { inscriptionLetters } from '@shared/lib/inscription';

interface Props {
  text: string;          // any Greek; accents, spaces and punctuation are dropped
  cols: number;
  rows?: number;         // cut to this many rows (default: as many as the text fills)
  accentRows?: number;   // the first N rows in the Kyanos blue
  fade?: boolean;        // fade the grid out towards its foot
}
const { text, cols, rows, accentRows = 0, fade = false } = Astro.props;
const letters = [...inscriptionLetters(text)].slice(0, rows ? cols * rows : undefined);
---
<div class:list={['stoi', { 'stoi-fade': fade }]} style={`--cols:${cols}`} aria-hidden="true">
  {letters.map((ch, i) => <span class:list={{ acc: i < accentRows * cols }}>{ch}</span>)}
</div>

<style>
  .stoi {
    display: grid;
    grid-template-columns: repeat(var(--cols), var(--cell-w, 1fr));
    grid-auto-rows: var(--cell-h, 1.2em);
    font-family: var(--font-caps);
    font-weight: 300;
    font-size: var(--cell-fs, 2rem);
    line-height: 1;
    text-align: center;
    color: var(--text);
    user-select: none;
  }
  .stoi span { display: block; }
  .stoi .acc { color: var(--accent); }
  .stoi-fade {
    -webkit-mask-image: linear-gradient(#000 50%, transparent);
    mask-image: linear-gradient(#000 50%, transparent);
  }
</style>
