---
// The site's top bar on every page but the reader (which has its own row):
// the wordmark, then Works · Search · Lexicon · Phrases · Support and the
// theme, in spaced capitals on the stone. On a phone the links fold into a
// menu beside a Search icon.
import ThemeToggle from './ThemeToggle.astro';

interface Props { current?: 'works' | 'search' | 'lexicon' | 'phrases' | 'support'; }
const { current } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const LINKS = [
  { key: 'works', label: 'Works', href: `${base}/` },
  { key: 'search', label: 'Search', href: `${base}/search` },
  { key: 'lexicon', label: 'Lexicon', href: `${base}/lemma/` },
  { key: 'phrases', label: 'Phrases', href: `${base}/phrases` },
  { key: 'support', label: 'Support', href: `${base}/support` },
] as const;
---
<header class="site-nav">
  <a class="site-brand" href={`${base}/`}><span lang="grc">ΠΛΑΤΩΝ</span><span class="site-brand-en"> · Plato Reader</span></a>
  <nav class="site-links" aria-label="Site">
    {LINKS.map((l) => (
      <a href={l.href} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a>
    ))}
  </nav>
  <a class="site-search-icon" href={`${base}/search`} aria-label="Search">
    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.2-4.2"/></svg>
  </a>
  <details class="site-menu">
    <summary aria-label="Menu">
      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </summary>
    <nav class="site-menu-panel" aria-label="Site">
      {LINKS.map((l) => (
        <a href={l.href} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
  </details>
  <ThemeToggle />
</header>
