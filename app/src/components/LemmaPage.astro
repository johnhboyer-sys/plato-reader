---
// A single lemma's reference page (the "lemma pages" spike), served at
// /lemma/<slug>. Fuses three layers over one Greek word:
//   ① LSJ definition (English)            — what it means
//   ② corpus-wide frequency + per-work    — how much Plato uses it
//   ③ a concordance sample                — every use links back into the reader
// Data is precomputed by scripts/build-lemmata.mjs into
// public/data/lemmata/<slug>.json; this page just renders it at build time.
import { readFileSync } from 'node:fs';
import ThemeInit from './ThemeInit.astro';
import SiteNav from './SiteNav.astro';
import SiteFooter from './SiteFooter.astro';
import PageHead from './PageHead.astro';
import Pwa from './Pwa.astro';
import Fonts from './Fonts.astro';
import { getWork, workPath, workLanding, bookLabel, isBookless } from '@shared/lib/works';
import { inscriptionLetters } from '@shared/lib/inscription';
import { greekNumeral } from '@shared/lib/numerals';
import { jsonLdSafe } from '../lib/jsonld';
import '@shared/styles/global.css';

interface Props { slug: string; }
const { slug } = Astro.props as Props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

type Instance = [col: string, line: number, surface: string];
interface ChapterInstances { chapter: string; bekker: string; instances: Instance[]; }
interface BookInstances { book: number; chapters: ChapterInstances[]; }
interface WorkInstances { work: string; title: string; count: number; shown: number; books: BookInstances[]; }
interface LemmaData {
  slug: string; key: string; head: string; lemmaBeta: string;
  count: number; glosses: string[];
  byWork: { work: string; title: string; count: number }[];
  instancesByWork: WorkInstances[];
  truncated: boolean;
}
const data: LemmaData = JSON.parse(
  readFileSync(`public/data/lemmata/${slug}.json`, 'utf-8'),
);

// The LSJ entry is served by grammata's T8 lookup at runtime — the same
// widget the reader's popup mounts — ported from aristotle-reader PR #109
// (John, 2026-09-03). Until then this page rendered the local shards through
// shared/lib/html.ts at build time. The LSJ key is the same beta-code key the
// concordance attributed the lemma to.

// Deep-link an instance back into the reader: scroll to the Bekker line and
// highlight the Greek word (the same ?hlg=&loc= mechanism search uses).
const instHref = (work: string, book: number, [col, line, surface]: Instance) =>
  `${base}${workPath(work, book)}?hlg=${encodeURIComponent(surface)}&loc=${col}:${line}`;

// Occurrences are cited by Stephanus page and section only (no line numbers),
// so the uses in one section fold into one link, to the first of them, with a
// count. (Plato's data carries no chapters: every chapter is "?".)
const bySection = (instances: Instance[]) => {
  const out: { col: string; first: Instance; n: number }[] = [];
  for (const inst of instances) {
    const last = out[out.length - 1];
    if (last && last.col === inst[0]) last.n += 1;
    else out.push({ col: inst[0], first: inst, n: 1 });
  }
  return out;
};

// Precompute the per-work view (book labels, per-book counts, flat-vs-drilldown)
// in the frontmatter — comparison operators like `<=` inside inline template
// expressions confuse Astro's JSX parser, so no logic lives in the markup.
const worksView = data.instancesByWork.map((w) => {
  const ww = getWork(w.work);
  const bookless = ww ? isBookless(ww) : false;
  return {
    ...w,
    bookless,
    flat: w.shown <= 30,             // small entries render fully expanded
    capped: w.shown < w.count,       // per-lemma INSTANCE_CAP truncated this work
    books: w.books.map((bk) => {
      const instances = bk.chapters.flatMap((c) => c.instances);
      return {
        book: bk.book,
        label: ww ? bookLabel(ww, bk.book) : String(bk.book),
        bookCount: instances.length,
        cites: bySection(instances),
      };
    }),
  };
});

// "Forms in Plato": each written form and how often it occurs, a grave folded
// to an acute (the same word at a sentence's middle and end). Counted from the
// occurrences the page lists, which the build caps for the commonest words.
const formCounts = new Map<string, number>();
let listed = 0;
for (const w of data.instancesByWork) for (const b of w.books) for (const c of b.chapters) for (const inst of c.instances) {
  const f = inst[2].normalize('NFD').replace(/̀/g, '́').normalize('NFC');
  formCounts.set(f, (formCounts.get(f) ?? 0) + 1);
  listed += 1;
}
const forms = [...formCounts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'el'));
const formsPartial = listed < data.count;

// The sections, numbered in order: the dictionary entry only when there is one.
const sectionNames = [...(data.key ? ['entry'] : []), 'forms', 'occurrences', 'bywork'];
const num = (name: string) => greekNumeral(sectionNames.indexOf(name) + 1);
const initial = [...inscriptionLetters(data.head)][0] ?? '';

// ── SEO ─────────────────────────────────────────────────────────────────────
const gloss = data.glosses[0] ?? '';
const pageTitle = `${data.head} (${data.slug}) — Plato's Greek Lexicon: ${gloss || 'definition & occurrences'}`;
const metaDescription =
  `${data.head} in Plato${gloss ? ` — "${gloss}"` : ''}. Appears ${data.count}` +
  ` times across the corpus (${data.byWork.slice(0, 3).map((b) => b.title).join(', ')}…),` +
  ` with the LSJ definition, frequency by work, and every occurrence linked to the` +
  ` parallel Greek–English text with Stephanus citation.`;
const canonical = Astro.site
  ? new URL(`${base}/lemma/${data.slug}/`, Astro.site).href : undefined;
const ogImage = Astro.site
  ? new URL(`${base}/og-default.png`, Astro.site).href : undefined;
const definedTerm = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTerm',
  name: data.head,
  ...(gloss ? { description: gloss } : {}),
  inLanguage: 'grc',
  ...(canonical ? { url: canonical } : {}),
  inDefinedTermSet: {
    '@type': 'DefinedTermSet',
    name: "Lexicon of Plato's Greek",
    url: Astro.site ? new URL(`${base}/lemma/`, Astro.site).href : undefined,
  },
};
const breadcrumb = Astro.site ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Plato', item: new URL(`${base}/`, Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Greek Lexicon', item: new URL(`${base}/lemma/`, Astro.site).href },
    { '@type': 'ListItem', position: 3, name: data.head, item: canonical },
  ],
} : null;
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ThemeInit />
  <title>{pageTitle}</title>
  <meta name="description" content={metaDescription} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="article" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={metaDescription} />
  {canonical && <meta property="og:url" content={canonical} />}
  <meta property="og:site_name" content="The Plato Reader" />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={metaDescription} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  <script type="application/ld+json" set:html={jsonLdSafe(definedTerm)} />
  {breadcrumb && <script type="application/ld+json" set:html={jsonLdSafe(breadcrumb)} />}
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="icon" href={`${base}/favicon.png`} type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} sizes="180x180" />
  <Fonts />
  <style>
    /* The head: the word large in Gentium, its gloss in italic, the counts in capitals. */
    .lm-hw { margin: 0.25rem 0 0.375rem; font-family: var(--font-greek); font-size: 3.25rem; font-weight: 400; line-height: 1.05; }
    .lm-gl { margin: 0; max-width: 42.5rem; font-size: 1.375rem; font-style: italic; }
    .lm-facts {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1.875rem;
      margin: 1rem 0 0;
      font-family: var(--font-caps);
      font-weight: 300;
      font-size: 0.75rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--text-mid);
    }
    .lm-facts b { font-weight: 300; font-size: 0.9375rem; letter-spacing: 0.04em; color: var(--text); }
    /* Two columns: the entry, its forms and its occurrences; by work at the right. */
    .lm-grid { display: grid; grid-template-columns: minmax(0, 1fr) 18.75rem; gap: 3.5rem; }
    .lm-grid .xp-h2:first-child { margin-top: 0; }
    .lm-side .xp-h2 { font-size: 1.25rem; }
    /* The dictionary entry, drawn by grammata at run time (nothing inside it is
       styled here): held to a few lines until "Read the full entry" opens it. */
    .lsj-clip { margin-top: 0.75rem; }
    .lsj-clip.clamped { max-height: 15rem; overflow: hidden; -webkit-mask-image: linear-gradient(#000 70%, transparent); mask-image: linear-gradient(#000 70%, transparent); }
    .more {
      margin-top: 0.5rem;
      padding: 0;
      border: none;
      border-bottom: 1px solid var(--accent);
      background: none;
      font-family: var(--font-english);
      font-size: 0.9375rem;
      color: var(--accent);
      cursor: pointer;
    }
    .more:hover { color: var(--text); border-bottom-color: var(--text); }
    .forms { display: flex; flex-wrap: wrap; gap: 0.375rem 1.125rem; margin: 0.625rem 0 0; font-size: 1.125rem; }
    .forms small { margin-left: 0.25rem; font-family: var(--font-caps); font-weight: 300; font-size: 0.6875rem; color: var(--text-mid); }
    /* Every occurrence: a ruled row per work that opens on its citations. */
    .occ { margin: 0.5rem 0 0; padding: 0; list-style: none; }
    .occ-work > summary {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto 0.75rem;
      gap: 0.75rem;
      align-items: baseline;
      padding: 0.5rem 0;
      border-bottom: 1px solid var(--border);
      font-size: 1rem;
      list-style: none;
      cursor: pointer;
    }
    .occ-work > summary::-webkit-details-marker { display: none; }
    .occ-work > summary:hover .occ-title { color: var(--accent); }
    .occ-n, .bywork .n { font-family: var(--font-caps); font-weight: 300; font-size: 0.8125rem; font-variant-numeric: tabular-nums; color: var(--text-mid); }
    .occ-caret { align-self: center; color: var(--text-mid); transition: transform 0.12s ease; }
    .occ-work[open] > summary .occ-caret { transform: rotate(180deg); }
    .occ-body { padding: 0.75rem 0 1rem; border-bottom: 1px solid var(--border); }
    .occ-open, .occ-book-sum {
      font-family: var(--font-caps);
      font-weight: 300;
      font-size: 0.6875rem;
      letter-spacing: var(--caps-tracking);
      text-transform: uppercase;
    }
    .occ-open { color: var(--accent); text-decoration: none; }
    .occ-open:hover { text-decoration: underline; }
    .occ-book { margin-top: 0.75rem; }
    .occ-book-sum { display: flex; gap: 0.75rem; align-items: baseline; color: var(--text); list-style: none; cursor: pointer; }
    .occ-book-sum::-webkit-details-marker { display: none; }
    .occ-book-sum:hover { color: var(--accent); }
    .occ-book-sum .occ-n { font-size: 0.75rem; }
    .cites { display: flex; flex-wrap: wrap; gap: 0.25rem 0.875rem; margin: 0.375rem 0 0; padding: 0; list-style: none; }
    .cites a { font-family: var(--font-caps); font-weight: 300; font-size: 0.8125rem; letter-spacing: 0.04em; color: var(--accent); text-decoration: none; }
    .cites a:hover { text-decoration: underline; }
    .cites small { margin-left: 0.125rem; font-size: 0.6875rem; color: var(--text-mid); }
    /* By work: ruled rows, the count at the right. */
    .bywork { margin: 0.5rem 0 0; padding: 0; list-style: none; }
    .bywork a { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: baseline; gap: 0.75rem; padding: 0.5rem 0; border-bottom: 1px solid var(--border); font-size: 1rem; color: var(--text); text-decoration: none; }
    .bywork a:hover { color: var(--accent); }
    .lm-back {
      margin: 2.5rem 0 0;
      font-family: var(--font-caps);
      font-weight: 300;
      font-size: 0.75rem;
      letter-spacing: var(--caps-tracking);
      text-transform: uppercase;
    }
    .lm-back a { color: var(--accent); text-decoration: none; }
    @media (max-width: 900px) {
      .lm-grid { grid-template-columns: minmax(0, 1fr); gap: 0; }
      .lm-side .xp-h2:first-child { margin-top: 2.25rem; }
    }
    @media (max-width: 680px) {
      .lm-hw { font-size: 2.375rem; }
      .lm-gl { font-size: 1.125rem; }
      .lm-facts { gap: 0.5rem 1.125rem; }
      .lm-grid .xp-h2 { font-size: 1.3125rem; }
    }
  </style>
  <Pwa />
</head>
<body>
  <SiteNav current="lexicon" />

  <main>
    <PageHead word={data.head}>
      <Fragment slot="label"><a href={`${base}/lemma/`}>Lexicon</a> › {initial}</Fragment>
      <h1 class="lm-hw" lang="grc">{data.head}</h1>
      {gloss && <p class="lm-gl">{data.glosses.join('; ')}</p>}
      <p class="lm-facts">
        <span><b>{data.count.toLocaleString()}</b> {data.count === 1 ? 'time' : 'times'}</span>
        <span>in <b>{data.byWork.length}</b> {data.byWork.length === 1 ? 'work' : 'works'}</span>
      </p>
    </PageHead>

    <div class="xp-body lm-grid">
      <div class="lm-main">
        {data.key && (
          <>
            <h2 class="xp-h2"><span class="n" aria-hidden="true">{num('entry')}</span>Dictionary entry<span class="tag">LSJ</span></h2>
            <div class="lsj-clip" id="lsj-entry">
              <div class="grammata-mount" data-key={data.key} lang="grc">Loading the dictionary entry…</div>
            </div>
            <button type="button" class="more" aria-expanded="false" aria-controls="lsj-entry" hidden>Read the full entry ▾</button>
          </>
        )}

        <h2 class="xp-h2"><span class="n" aria-hidden="true">{num('forms')}</span>Forms in Plato</h2>
        <p class="forms">
          {forms.map(([f, n]) => <span><span lang="grc">{f}</span><small>{n.toLocaleString()}</small></span>)}
        </p>
        {formsPartial && (
          <p class="xp-note">Counted from the {listed.toLocaleString()} occurrences listed below, of {data.count.toLocaleString()}.</p>
        )}

        <h2 class="xp-h2"><span class="n" aria-hidden="true">{num('occurrences')}</span>Every occurrence</h2>
        <p class="xp-note">Open a work to list every occurrence by Stephanus page; each links into the reader.</p>
        <ul class="occ">
          {worksView.map((w) => (
            <li id={`w-${w.work}`}>
              <details class="occ-work">
                <summary>
                  <span class="occ-title">{w.title}</span>
                  <span class="occ-n">{w.count.toLocaleString()}</span>
                  <svg class="occ-caret" width="10" height="6" viewBox="0 0 10 6" aria-hidden="true" fill="currentColor"><path d="M0 0l5 6 5-6z"/></svg>
                </summary>
                <div class="occ-body">
                  <a class="occ-open" href={`${base}${workLanding(w.work)}`}>Open {w.title} ›</a>
                  {w.books.map((bk) => (
                    w.bookless ? (
                      <ul class="cites">
                        {bk.cites.map((c) => (
                          <li><a href={instHref(w.work, bk.book, c.first)}>{c.col}</a>{c.n > 1 && <small>×{c.n}</small>}</li>
                        ))}
                      </ul>
                    ) : (
                      <details class="occ-book" open={w.flat}>
                        <summary class="occ-book-sum">
                          <span>Book {bk.label}</span>
                          <span class="occ-n">{bk.bookCount}</span>
                        </summary>
                        <ul class="cites">
                          {bk.cites.map((c) => (
                            <li><a href={instHref(w.work, bk.book, c.first)}>{c.col}</a>{c.n > 1 && <small>×{c.n}</small>}</li>
                          ))}
                        </ul>
                      </details>
                    )
                  ))}
                  {w.capped && (
                    <p class="xp-note">Showing {w.shown.toLocaleString()} of {w.count.toLocaleString()} (list capped).</p>
                  )}
                </div>
              </details>
            </li>
          ))}
        </ul>
        <p class="lm-back"><a href={`${base}/lemma/`}>All lexicon entries ›</a></p>
      </div>

      <aside class="lm-side">
        <h2 class="xp-h2"><span class="n" aria-hidden="true">{num('bywork')}</span>By work</h2>
        <ul class="bywork">
          {data.byWork.map((b) => (
            <li><a href={`#w-${b.work}`} data-work={b.work}><span>{b.title}</span><span class="n">{b.count.toLocaleString()}</span></a></li>
          ))}
        </ul>
      </aside>
    </div>
  </main>
  <SiteFooter />
</body>
</html>

<script>
  // Served by grammata (grammar-site's deploy), not rendered here — the same
  // contract as the reader's popup: do not vendor, proxy, pin or cache-bust
  // this URL (its deploys ARE the update mechanism) and do not style anything
  // inside the container. With a key the word argument is ignored; lang:'grc'
  // skips the Latin fetch.
  const GRAMMATA_LOOKUP = 'https://grammata.pages.dev/t8/lookup.js';
  const mount = document.querySelector<HTMLElement>('.grammata-mount');
  const key = mount?.dataset.key;
  if (mount && key) {
    // @vite-ignore keeps the remote specifier out of the bundle graph.
    import(/* @vite-ignore */ GRAMMATA_LOOKUP)
      .then((m) => m.lookup('', mount, { lang: 'grc', key }))
      .catch((e) => {
        // A failed module load is the one case the widget cannot report itself.
        mount.textContent = 'The dictionary entry is not available here.';
        console.error('[grammata] lookup failed', e);
      });
  }

  // "Read the full entry": a long entry is held to a few lines until asked.
  // The entry arrives after the page does, so the button shows only once the
  // entry has grown past the clamp.
  const clip = document.getElementById('lsj-entry');
  const more = document.querySelector<HTMLButtonElement>('.more');
  if (mount && clip && more) {
    const fit = () => {
      if (more.getAttribute('aria-expanded') === 'true') return;
      clip.classList.add('clamped');
      const long = clip.scrollHeight > clip.clientHeight + 8;
      clip.classList.toggle('clamped', long);
      more.hidden = !long;
    };
    new ResizeObserver(fit).observe(mount);
    more.addEventListener('click', () => {
      const open = more.getAttribute('aria-expanded') !== 'true';
      more.setAttribute('aria-expanded', String(open));
      clip.classList.toggle('clamped', !open);
      more.textContent = open ? 'Show less ▴' : 'Read the full entry ▾';
    });
  }

  // A work in "By work" opens that work's occurrences.
  const openWork = (id: string) => {
    const d = document.getElementById(id)?.querySelector('details');
    if (d) d.open = true;
  };
  document.querySelectorAll<HTMLAnchorElement>('.bywork a').forEach((a) =>
    a.addEventListener('click', () => openWork(a.getAttribute('href')!.slice(1))));
  if (location.hash.startsWith('#w-')) openWork(decodeURIComponent(location.hash.slice(1)));
</script>
