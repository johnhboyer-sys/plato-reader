---
import { readdirSync } from 'node:fs';
import { join, resolve } from 'node:path';
import Phrases from '@shared/components/Phrases.svelte';
import CompareWorks from '@shared/components/CompareWorks.svelte';
import ThemeInit from '../components/ThemeInit.astro';
import Pwa from '../components/Pwa.astro';
import Fonts from '../components/Fonts.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PageHead from '../components/PageHead.astro';
import { jsonLdSafe } from '../lib/jsonld';
import '@shared/styles/global.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Which browse letters exist, read off the built shards rather than typed. The
// three streams do not shard alike (the English has a j and a v the Greek has
// no letter for, and no x), and a rebuild can drop a letter — a button for a
// shard that is not there would 404 in the reader's face.
// Astro bundles a page's frontmatter into a build chunk, so `import.meta.url`
// does not point at this file. The build always runs with the app directory as
// its working directory (see scripts/build-public.mjs).
const ngramRoot = resolve(process.cwd(), 'public/data/ngrams');
function shardLetters(stream: string): string[] {
  try {
    return readdirSync(join(ngramRoot, stream))
      .filter((name) => /^[a-z_]\.json$/.test(name))
      .map((name) => name[0])
      .sort();
  } catch {
    return [];   // no corpus built here; the page still renders, without browse buttons
  }
}
const letters = {
  form: shardLetters('form'),
  lemma: shardLetters('lemma'),
  english: shardLetters('english'),
};
// The occurrence files Compare works reads, likewise off the build: stage 8
// writes no file for a letter and length that hold no phrase.
function occFiles(stream: string): string[] {
  try {
    return readdirSync(join(ngramRoot, stream, 'occ'))
      .filter((name) => /^[a-z_]-[2-5]\.json$/.test(name))
      .map((name) => name.slice(0, -'.json'.length))
      .sort();
  } catch {
    return [];
  }
}
const compareFiles = { form: occFiles('form'), lemma: occFiles('lemma') };

const phraseDescription =
  'Browse recurrent two- to five-word Greek phrases across the complete works of' +
  ' Plato, sortable by distinctiveness, frequency, length, or alphabetically,' +
  ' with every occurrence linked by Stephanus page.';
const canonical = Astro.site ? new URL(`${base}/phrases/`, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(`${base}/og-default.png`, Astro.site).href : undefined;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Phrases in Plato',
  description: phraseDescription,
  ...(canonical ? { url: canonical } : {}),
  isPartOf: { '@type': 'WebSite', name: 'The Plato Reader' },
};
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ThemeInit />
  <title>Phrases in Plato</title>
  <meta name="description" content={phraseDescription} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content="Phrases in Plato" />
  <meta property="og:description" content={phraseDescription} />
  <meta property="og:site_name" content="The Plato Reader" />
  {canonical && <meta property="og:url" content={canonical} />}
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Phrases in Plato" />
  <meta name="twitter:description" content={phraseDescription} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  <script type="application/ld+json" set:html={jsonLdSafe(jsonLd)} />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="icon" href={`${base}/favicon.png`} type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} sizes="180x180" />
  <Fonts />
  <Pwa />
</head>
<body>
  <SiteNav current="phrases" />
  <main>
    <PageHead word="φράσεις" label="Phrase index">
      <h1 class="xp-h1">Phrases in Plato</h1>
      <p class="xp-lead">
        Recurrent two- to five-word phrases across the complete works, ranked by
        how distinctive they are.
      </p>
    </PageHead>
    <div class="xp-switch ph-tabs" role="group" aria-label="Phrase tools">
      <button type="button" data-tab="phrases" aria-pressed="true">Phrases</button>
      <button type="button" data-tab="compare" aria-pressed="false">Compare works</button>
    </div>
    <div id="tab-phrases">
      <Phrases client:load letters={letters} />
    </div>
    <div id="tab-compare" hidden>
      <CompareWorks client:idle occFiles={compareFiles} />
    </div>
  </main>
  <SiteFooter />
  <script>
    // Two tabs: the phrase index, and Compare works (#compare).
    const tabs = document.querySelectorAll<HTMLButtonElement>('.ph-tabs [data-tab]');
    function show(name: string) {
      for (const t of tabs) {
        const on = t.dataset.tab === name;
        t.setAttribute('aria-pressed', String(on));
        document.getElementById(`tab-${t.dataset.tab}`)!.hidden = !on;
      }
    }
    for (const t of tabs) {
      t.addEventListener('click', () => {
        const name = t.dataset.tab!;
        show(name);
        history.replaceState(null, '', name === 'compare' ? '#compare' : location.pathname + location.search);
      });
    }
    if (location.hash === '#compare') show('compare');
  </script>
</body>
</html>
