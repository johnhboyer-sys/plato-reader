---
// A shareable on-site support/donation page. Giving itself goes through the
// Stripe Payment Link (SUPPORT_URL); this page gives that appeal a real URL on
// our own domain with a branded Open Graph card (public/og-support.png).
import ThemeInit from '../components/ThemeInit.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PageHead from '../components/PageHead.astro';
import Pwa from '../components/Pwa.astro';
import Fonts from '../components/Fonts.astro';
import { SUPPORT_URL } from '../lib/support';
import { jsonLdSafe } from '../lib/jsonld';
import { greekNumeral } from '@shared/lib/numerals';
import { inscriptionCaps } from '@shared/lib/inscription';
import '@shared/styles/global.css';

// What a gift pays for, numbered Α Β Γ.
const uses = [
  'Hosting and the tools that keep the site fast and ad-free.',
  'Aligning more public-domain translations to the Greek, line by line.',
  'Adding works, glossaries, and reading aids across the corpus.',
];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pageTitle = 'Support the Plato Reader';
const metaDescription =
  'Help keep the Plato Reader free and open — an ad-free parallel ' +
  'Greek–English edition of Plato’s dialogues, with click-to-parse ' +
  'morphology, dictionary entries, and exact Stephanus citation.';
const canonical = Astro.site
  ? new URL(`${base}/support/`, Astro.site).href : undefined;
const ogImage = Astro.site
  ? new URL(`${base}/og-support.png`, Astro.site).href : undefined;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: pageTitle,
  description: metaDescription,
  ...(canonical ? { url: canonical } : {}),
  isPartOf: { '@type': 'WebSite', name: 'The Plato Reader' },
  potentialAction: {
    '@type': 'DonateAction',
    target: SUPPORT_URL,
  },
};
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ThemeInit />
  <title>{pageTitle}</title>
  <meta name="description" content={metaDescription} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={metaDescription} />
  {canonical && <meta property="og:url" content={canonical} />}
  <meta property="og:site_name" content="The Plato Reader" />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={metaDescription} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  <script type="application/ld+json" set:html={jsonLdSafe(jsonLd)} />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="icon" href={`${base}/favicon.png`} type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} sizes="180x180" />
  <Fonts />
  <style>
    .xp-prose p:first-child { margin-top: 0; }
    /* What a gift pays for: three columns on one ink rule, each opening on
       its Greek numeral. */
    .uses {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.75rem;
      max-width: 56.25rem;
      margin: 1.375rem 0 0;
      padding: 1rem 0 0;
      list-style: none;
      border-top: 1px solid var(--text);
    }
    .uses li { display: grid; grid-template-columns: 2.125rem minmax(0, 1fr); font-size: 1rem; line-height: 1.5; }
    .uses .n { font-family: var(--font-caps); font-weight: 300; font-size: 1.375rem; line-height: 1.1; color: var(--accent); }
    .gift { display: flex; align-items: center; gap: 1.375rem; margin-top: 1.875rem; }
    .gift .xp-btn { flex: none; padding: 0.9375rem 1.625rem; }
    .gift p { margin: 0; max-width: 30em; font-size: 0.875rem; color: var(--text-mid); }
    @media (max-width: 680px) {
      .uses { grid-template-columns: minmax(0, 1fr); gap: 0.875rem; }
      .gift { display: block; }
      .gift .xp-btn { display: block; text-align: center; }
      .gift p { margin-top: 0.75rem; }
    }
  </style>
  <Pwa />
</head>
<body>
  <SiteNav current="support" />

  <main>
    <PageHead word="χάρις" label={`Support · ${inscriptionCaps('χάρις')}`}>
      <h1 class="xp-h1">Support the Plato Reader</h1>
    </PageHead>
    <div class="xp-body">
      <div class="xp-prose">
        <p>
          The Plato Reader is an ad-free parallel Greek–English edition of
          Plato’s dialogues, with click-to-parse morphology, dictionary
          entries, and exact Stephanus citation. It is free to read and always will be.
        </p>
        <p>
          It is built and maintained by one person, and runs on no advertising and no
          paywall. A contribution helps defray development costs and keeps the reader
          free and open for students, teachers, and readers everywhere.
        </p>
      </div>
      <ol class="uses">
        {uses.map((u, i) => <li><span class="n" aria-hidden="true">{greekNumeral(i + 1)}</span><span>{u}</span></li>)}
      </ol>
      <div class="gift">
        <a class="xp-btn" href={SUPPORT_URL} target="_blank" rel="noopener">Make a gift</a>
        <p>Gifts are processed securely by Stripe; you choose the amount. Thank you for keeping the reader free.</p>
      </div>
    </div>
  </main>
  <SiteFooter />
</body>
</html>
