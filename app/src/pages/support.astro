---
// A shareable on-site support/donation page. Giving itself goes through the
// Stripe Payment Link (SUPPORT_URL); this page gives that appeal a real URL on
// our own domain with a branded Open Graph card (public/og-support.png).
import ThemeInit from '../components/ThemeInit.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Pwa from '../components/Pwa.astro';
import Fonts from '../components/Fonts.astro';
import { SUPPORT_URL } from '../lib/support';
import { jsonLdSafe } from '../lib/jsonld';
import '@shared/styles/global.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pageTitle = 'Support the Plato Reader';
const metaDescription =
  'Help keep the Plato Reader free and open — an ad-free parallel ' +
  'Greek–English edition of Plato’s dialogues, with click-to-parse ' +
  'morphology, dictionary entries, and exact Stephanus citation.';
const canonical = Astro.site
  ? new URL(`${base}/support/`, Astro.site).href : undefined;
const ogImage = Astro.site
  ? new URL(`${base}/og-support.png`, Astro.site).href : undefined;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: pageTitle,
  description: metaDescription,
  ...(canonical ? { url: canonical } : {}),
  isPartOf: { '@type': 'WebSite', name: 'The Plato Reader' },
  potentialAction: {
    '@type': 'DonateAction',
    target: SUPPORT_URL,
  },
};
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ThemeInit />
  <title>{pageTitle}</title>
  <meta name="description" content={metaDescription} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={metaDescription} />
  {canonical && <meta property="og:url" content={canonical} />}
  <meta property="og:site_name" content="The Plato Reader" />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={metaDescription} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  <script type="application/ld+json" set:html={jsonLdSafe(jsonLd)} />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="icon" href={`${base}/favicon.png`} type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} sizes="180x180" />
  <Fonts />
  <style>
    .sp-body { max-width: 640px; margin: 0 auto; padding: 3.5rem 1.25rem 5rem; font-family: var(--font-english); color: var(--text); }
    .sp-eyebrow {
      font-family: var(--font-caps); font-size: 0.75rem; font-weight: 300;
      letter-spacing: var(--caps-tracking); text-transform: uppercase; color: var(--accent);
      display: flex; align-items: baseline; gap: 0.6rem; margin: 0 0 0.6rem;
    }
    .sp-eyebrow .gk { font-family: var(--font-greek); font-size: 1.05rem; letter-spacing: 0; text-transform: none; }
    .sp-body h1 { font-family: var(--font-english); font-weight: 400; font-size: 2.875rem; line-height: 1.1; margin: 0 0 1.1rem; }
    .sp-lede { font-size: 1.1875rem; line-height: 1.6; margin: 0 0 1.1rem; }
    .sp-body p { font-size: 1.0625rem; line-height: 1.7; color: var(--text-mid); margin: 0 0 1.1rem; }
    .sp-cta { margin: 1.75rem 0 1.4rem; }
    .sp-list { list-style: none; padding: 0.9rem 0 0; margin: 0 0 1.6rem; display: grid; gap: 0.6rem; border-top: 1px solid var(--border); }
    .sp-list li { font-size: 1.0625rem; line-height: 1.55; color: var(--text-mid); padding-left: 1.5rem; position: relative; }
    .sp-list li::before { content: "χ"; font-family: var(--font-greek); color: var(--accent); position: absolute; left: 0; top: 0; }
    .sp-note { font-size: 0.95rem; color: var(--text-mid); }
    .sp-note a { color: var(--text); text-decoration: underline; text-underline-offset: 0.2em; }
    @media (max-width: 680px) { .sp-body { padding-top: 2rem; } .sp-body h1 { font-size: 2rem; } }
  </style>
  <Pwa />
</head>
<body>
  <SiteNav current="support" />

  <main class="sp-body">
    <p class="sp-eyebrow">Support <span class="gk">χάρις</span></p>
    <h1>Support the Plato Reader</h1>
    <p class="sp-lede">
      The Plato Reader is an ad-free parallel Greek–English edition of
      Plato’s dialogues — with click-to-parse morphology, dictionary
      entries, and exact Stephanus citation. It is free to read and always will be.
    </p>
    <p>
      It is built and maintained by one person, and runs on no advertising and no
      paywall. A contribution helps defray development costs and keeps the reader
      free and open for students, teachers, and readers everywhere.
    </p>
    <ul class="sp-list">
      <li>Hosting and the tools that keep the site fast and ad-free.</li>
      <li>Aligning more public-domain translations to the Greek, line by line.</li>
      <li>Adding works, glossaries, and reading aids across the corpus.</li>
    </ul>
    <div class="sp-cta">
      <a class="xp-btn" href={SUPPORT_URL} target="_blank" rel="noopener">Make a gift</a>
    </div>
    <p class="sp-note">
      Gifts are processed securely by Stripe — you choose the amount. Thank you
      for keeping the reader free. <span class="gk" style="font-family:var(--font-greek);color:var(--accent);">χάρις</span>.
    </p>
  </main>
  <SiteFooter />
</body>
</html>
