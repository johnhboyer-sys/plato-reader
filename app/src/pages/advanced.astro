---
import { readFileSync, readdirSync } from 'node:fs';
import { resolve } from 'node:path';
import ThemeInit from '../components/ThemeInit.astro';
import Pwa from '../components/Pwa.astro';
import Fonts from '../components/Fonts.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { jsonLdSafe } from '../lib/jsonld';
import { WORKS, AUTHENTIC_IDS } from '@shared/lib/works';
import { greekNumeral } from '@shared/lib/numerals';
import '@shared/styles/global.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// The guide's contents column, numbered Α–Ζ like the section heads.
const TOC = [
  { id: 'typing', title: 'Typing Greek', gist: 'Beta Code and the keyboard' },
  { id: 'wildcards', title: 'Wildcards', gist: 'find a word you only partly know' },
  { id: 'lemma', title: 'Lemma', gist: 'every form of one dictionary word' },
  { id: 'variants', title: 'Word endings', gist: 'one phrase, all its forms' },
  { id: 'english', title: 'English searches', gist: 'any form, every translation, and both languages' },
  { id: 'grammatical', title: 'Search by grammar', gist: 'find forms, not spellings' },
  { id: 'combo', title: 'Proximity', gist: 'two ideas in one passage' },
  { id: 'speaker', title: 'Who is speaking', gist: 'a word in one voice only' },
  { id: 'results', title: 'Reading the results', gist: 'group, sort, and narrow' },
  { id: 'phrases', title: 'The phrase index', gist: 'what Plato repeats' },
  { id: 'honesty', title: 'What these tools cannot tell you', gist: '' },
];
// A section's Greek numeral is its place in the contents column.
const num = (id: string) => greekNumeral(TOC.findIndex((t) => t.id === id) + 1);

// ── Every number on this page, measured off the built corpus ──────────────
//
// Not one figure below is typed from a session. The sister site shipped its
// guide with a word count that was one work only and a phrase count four times
// off, because the numbers were written down once and the corpus was rebuilt
// after. These are read out of the artifacts this site serves, so a rebuild
// corrects them. Anything the artifacts cannot answer renders as TKTK rather
// than as a plausible guess.
// Astro bundles a page's frontmatter into a build chunk, so `import.meta.url`
// does not point at this file. The build always runs with the app directory as
// its working directory (see scripts/build-public.mjs).
const dataRoot = resolve(process.cwd(), 'public/data');
const TKTK = 'TKTK';
const nf = new Intl.NumberFormat('en-US');
const scoreFmt = new Intl.NumberFormat('en-US', { maximumFractionDigits: 1 });

function readJson<T>(rel: string): T | null {
  try { return JSON.parse(readFileSync(resolve(dataRoot, rel), 'utf8')) as T; } catch { return null; }
}
function readBytes(rel: string): Buffer | null {
  try { return readFileSync(resolve(dataRoot, rel)); } catch { return null; }
}
const n = (v: number | null | undefined) =>
  typeof v === 'number' && Number.isFinite(v) ? nf.format(v) : TKTK;

interface Offsets {
  token_count: number;
  turn_bounds?: { speaker: string; start: number }[];
}
interface Summary {
  works: number;
  streams: Record<string, { kept: number }>;
  surface_forms: number;
  surface_forms_ambiguous: number;
}
type Reading = Record<string, string[]>;
interface GrammarDict { width: number; sigs: Reading[][] }
type NgramRow = [number, number, number, number, number?];

let workIds: string[] = [];
try {
  workIds = readdirSync(dataRoot, { withFileTypes: true })
    .filter((e) => e.isDirectory())
    .map((e) => e.name)
    .filter((id) => readJson<Offsets>(`${id}/search/offsets.json`) !== null)
    .sort();
} catch { workIds = []; }

const summary = readJson<Summary>('ngrams/summary.json');
const tokens = workIds.length
  ? workIds.reduce((sum, id) => sum + (readJson<Offsets>(`${id}/search/offsets.json`)?.token_count ?? 0), 0)
  : null;

// Distinct surface-form index keys, corpus-wide and in one dialogue — what a
// wildcard actually reaches.
type Index = Record<string, unknown>;
const formKeys = new Set<string>();
for (const id of workIds) {
  for (const key of Object.keys(readJson<Index>(`${id}/search/greek_form.json`) ?? {})) formKeys.add(key);
}
const republicKeys = Object.keys(readJson<Index>('Republic/search/greek_form.json') ?? {});
const withPrefix = (keys: Iterable<string>, prefix: string) => {
  let count = 0;
  for (const key of keys) if (key.startsWith(prefix)) count++;
  return count;
};
const wildcard = formKeys.size
  ? {
      distinct: formKeys.size,
      l: withPrefix(formKeys, 'l'),
      fron: withPrefix(formKeys, 'fron'),
      dikaio: withPrefix(formKeys, 'dikaio'),
      republicL: republicKeys.length ? withPrefix(republicKeys, 'l') : null,
      // A star inside a word, as the search reads it: l*s is every word that
      // begins with λ and ends with ς, matched over the whole key.
      lS: [...formKeys].filter((key) => /^l[a-z']*s$/.test(key)).length,
    }
  : null;

// English "any form", counted over the primary translations' index the search
// reads: each posting is one occurrence of the word.
const englishCount = (words: string[]) => {
  if (!workIds.length) return null;
  let total = 0;
  for (const id of workIds) {
    const idx = readJson<Record<string, unknown[]>>(`${id}/search/english.json`);
    if (!idx) return null;
    for (const w of words) total += Object.hasOwn(idx, w) ? idx[w].length : 0;
  }
  return total;
};
const soul = { one: englishCount(['soul']), forms: englishCount(['souls', "soul's"]) };

// The translations beyond the primary, as the search asks them: a work counts
// only if its index for that translation is in the built data.
const jowettWorks = workIds.filter((id) => readBytes(`${id}/search/english-overlay-jowett.json`) !== null);

// The headword picker's choices: one per fold key of the lemma index.
let pickerKeys: number | null = null;
try {
  pickerKeys = readdirSync(resolve(dataRoot, 'lemma-picker'))
    .filter((f) => f.endsWith('.json'))
    .reduce((sum, f) => sum + Object.keys(readJson<Index>(`lemma-picker/${f}`) ?? {}).length, 0) || null;
} catch { pickerKeys = null; }

// A grammatical query, counted over the packed column exactly as the search
// runs it: how many tokens match, and how many of those the parse settles.
function grammarCount(query: Record<string, string>): { total: number; certain: number } | null {
  if (!workIds.length) return null;
  let total = 0;
  let certain = 0;
  for (const id of workIds) {
    const dict = readJson<GrammarDict>(`${id}/search/grammar-dict.json`);
    const buffer = readBytes(`${id}/search/grammar-col.bin`);
    if (!dict || !buffer) return null;
    const column = dict.width === 4
      ? new Uint32Array(buffer.buffer, buffer.byteOffset, buffer.byteLength / 4)
      : new Uint16Array(buffer.buffer, buffer.byteOffset, buffer.byteLength / 2);
    const satisfies = (r: Reading) => Object.entries(query).every(([c, v]) => r[c]?.includes(v));
    const matched = new Map<number, boolean>();
    dict.sigs.forEach((readings, sig) => {
      if (!readings.length || !readings.some(satisfies)) return;
      const settled = readings.every(satisfies)
        && Object.keys(query).every((c) => new Set(readings.flatMap((r) => r[c] ?? [])).size === 1);
      matched.set(sig, settled);
    });
    for (const sig of column) {
      const settled = matched.get(sig);
      if (settled === undefined) continue;
      total++;
      if (settled) certain++;
    }
  }
  return { total, certain };
}
const genPlFem = grammarCount({ case: 'gen', number: 'pl', gender: 'fem' });
const optative = grammarCount({ mood: 'opt' });
const genDual = grammarCount({ case: 'gen', number: 'dual' });

// One phrase-index row, by its fold key. Null when the rebuild no longer keeps
// it, which is what the TKTK is for.
function ngramRow(stream: 'form' | 'lemma' | 'english', key: string) {
  const shard = readJson<Record<string, NgramRow>>(`ngrams/${stream}/${key[0]}.json`);
  const row = shard?.[key];
  return row ? { words: row[0], count: row[1], score: row[2], works: row[3] } : null;
}
const score = (v: number | undefined) =>
  typeof v === 'number' && Number.isFinite(v) ? scoreFmt.format(v) : TKTK;

const said = ngramRow('form', "hn d' egw");
const saidLemma = ngramRow('lemma', 'hmi de egw');
const certainly = ngramRow('form', 'panu men oun');
const certainlyLemma = ngramRow('lemma', 'panu men oun');
const soToSpeak = ngramRow('form', 'ws epos eipein');
const theBeautiful = ngramRow('form', 'to kalon');
const theBeautifulLemma = ngramRow('lemma', 'o kalos');

// The cast, as the search sees it: which works carry speaker labels at all,
// and how the turns fall. The narrated works have none in the OCT, so their
// titles are read off the registry rather than typed here.
const titleOf = (id: string) => WORKS.find((w) => w.id === id)?.title ?? id;
const list = (items: string[]) =>
  items.length < 3 ? items.join(' and ') : `${items.slice(0, -1).join(', ')}, and ${items[items.length - 1]}`;
// The works the registry marks dubious, and the rest, as the In row counts them.
const works = {
  all: WORKS.length,
  authentic: AUTHENTIC_IDS.length,
  dubious: WORKS.filter((w) => w.authenticity && w.authenticity !== 'genuine').map((w) => w.title),
};
const turnCounts = new Map<string, number>();
const labelledWorks: string[] = [];
const unlabelledWorks: string[] = [];
// Reported dialogues: the labels are a narrator's frame, not the speakers
// (works.ts `narrator`), so the filter leaves them out as it does the works
// with no labels — and this page says which they are.
const narratedWorks = workIds.filter((id) => WORKS.find((w) => w.id === id)?.narrator);
for (const id of workIds) {
  const bounds = readJson<Offsets>(`${id}/search/offsets.json`)?.turn_bounds ?? [];
  if (narratedWorks.includes(id)) continue;
  (bounds.length ? labelledWorks : unlabelledWorks).push(id);
  for (const t of bounds) {
    if (t.speaker) turnCounts.set(t.speaker, (turnCounts.get(t.speaker) ?? 0) + 1);
  }
}
const speakers = workIds.length
  ? {
      labelled: labelledWorks.length,
      unlabelledTitles: unlabelledWorks.map(titleOf),
      narratedTitles: narratedWorks.map((id) => `${titleOf(id)} (${WORKS.find((w) => w.id === id)?.narrator})`),
      distinct: turnCounts.size,
      socrates: turnCounts.get('Socrates') ?? null,
      turns: [...turnCounts.values()].reduce((a, b) => a + b, 0),
    }
  : null;

const corpus = {
  works: summary?.works ?? workIds.length,
  tokens,
  formPhrases: summary?.streams?.form?.kept ?? null,
  lemmaPhrases: summary?.streams?.lemma?.kept ?? null,
  englishPhrases: summary?.streams?.english?.kept ?? null,
  surfaceForms: summary?.surface_forms ?? null,
  ambiguousForms: summary?.surface_forms_ambiguous ?? null,
};

// The English index runs on whichever translation each dialogue carries in the
// primary slot — the Loeb, throughout. Counted off the registry rather than
// written down, so adding or replacing a translation corrects this sentence.
const englishTranslators = new Set(
  WORKS.flatMap((w) =>
    (w.translations ?? [])
      .filter((t) => t.slot === 'english')
      .map((t) => t.name.replace(/\s*\(.*$/, '')),
  ),
).size || null;

// Searches this page sends a reader to, written as the search page writes them.
const searchHref = (q: string) => `${base}/search/?${q}`;
const tryNear = searchHref('c=l:areth&c=l:episthmh');
const tryOr = searchHref('c=l:areth&c=l:hdonh&c=lo:luph');
const tryNot = searchHref('c=l:areth&c=lb:hdonh&c=ln:luph&cw=10');
const tryGrammar = searchHref('c=g:tense.aor,voice.pass,mood.part&w=Phaedo');

const title = 'How search works';
const description =
  'How to search Plato in Greek and English: Beta Code, wildcards, a single' +
  ' dictionary word, every form of a phrase, every translation, grammar,' +
  ' proximity, a speaker filter, and the phrase index, with worked examples' +
  ' and what each tool cannot tell you.';
const canonical = Astro.site ? new URL(`${base}/advanced/`, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(`${base}/og-default.png`, Astro.site).href : undefined;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  name: title,
  description,
  ...(canonical ? { url: canonical } : {}),
  isPartOf: { '@type': 'WebSite', name: 'The Plato Reader' },
};
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ThemeInit />
  <title>{title}</title>
  <meta name="description" content={description} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="article" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:site_name" content="The Plato Reader" />
  {canonical && <meta property="og:url" content={canonical} />}
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  <script type="application/ld+json" set:html={jsonLdSafe(jsonLd)} />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="icon" href={`${base}/favicon.png`} type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} sizes="180x180" />
  <Fonts />
  <Pwa />
</head>
<body>
  <SiteNav current="search" />

  <main class="guide">
    <!-- The contents column, numbered Α–Ζ like the section heads it lists. -->
    <nav class="guide-toc" aria-label="On this page">
      <ol>
        {TOC.map((t, i) => (
          <li>
            <a href={`#${t.id}`}>
              <span class="toc-n" aria-hidden="true">{greekNumeral(i + 1)}</span>
              <span class="toc-t">{t.title}{t.gist && <small>{t.gist}</small>}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
    <article class="guide-body">
    <p class="guide-eyebrow">A guide</p>
    <h1>How search works</h1>
    <p class="guide-lede">
      Tools for asking questions of Plato's Greek, and of its translations,
      that a plain word search cannot answer. You need no Greek for most of
      them, and you can read the sections in any order. Every number on this
      page is counted from the texts this site serves: {n(corpus.works)} works,
      {n(corpus.tokens)} Greek words. Check any of them against the search
      itself.
    </p>

    <section id="first">
      <h2>First, three things worth knowing</h2>
      <p>
        <strong>Greek changes the ends of words.</strong> English mostly does not:
        "virtue" looks the same wherever it stands. Greek changes the ending to
        show the word's job, so <span lang="grc">ἀρετή</span>,
        <span lang="grc">ἀρετῆς</span>, and <span lang="grc">ἀρετήν</span> are
        one word doing three jobs. A search for one spelling would miss most of
        the places the word occurs. That is why Form starts at <em>Any form of
        this word</em>: type any form, and the search finds them all.
      </p>
      <p>
        <strong>The search reads every work.</strong> <em>In</em> starts at
        <em>all works</em>: all {n(works.all)}, including the
        {n(works.dubious.length)} marked dubious ({list(works.dubious)}). Set In
        to <em>authentic works</em> for the other {n(works.authentic)}, or
        <em>choose works…</em> to pick your own.
      </p>
      <p>
        <strong>You can type Greek without a Greek keyboard.</strong> Type
        <code>texnh</code> and the search reads <span lang="grc">τέχνη</span>.
        <a href="#typing">Typing Greek</a> has the details.
      </p>
      <p class="guide-note">
        Numbers like <strong>34b</strong> are Stephanus pages and sections, the
        standard way of citing Plato. Most editions print them in the margin, so
        the same number finds the same passage in any edition or translation.
        Results here cite by page and section, never by line, and the search
        counts sections: each one with a hit counts once.
      </p>
    </section>

    <section id="typing">
      <h2><span class="gh-n" aria-hidden="true">{num('typing')}</span>Typing Greek</h2>
      <p class="guide-q">Use this when you have no Greek keyboard.</p>
      <p>
        Beta Code writes Greek in Latin letters, one Latin letter for each Greek
        one, with marks written after the letter they belong to:
        <code>a)reth/</code> is <span lang="grc">ἀρετή</span>, and
        <code>texnh</code> is <span lang="grc">τέχνη</span>. Scholars have long
        used it to put Greek into computers, and the Greek box reads it without
        being asked. <code>h</code> is <span lang="grc">η</span> and
        <code>w</code> is <span lang="grc">ω</span>, so <code>e</code> and
        <code>o</code> stay short. <code>q</code> is <span lang="grc">θ</span>,
        <code>c</code> is <span lang="grc">ξ</span>, and <code>x</code> is
        <span lang="grc">χ</span>. A final <code>s</code> becomes
        <span lang="grc">ς</span> by itself.
      </p>
      <p>
        <em>Beta Code</em>, beside the Greek box, turns your letters into Greek
        as you type: <code>a)reth/</code> becomes <span lang="grc">ἀρετή</span>
        in the box, so you can see what you asked for. With it off, the box keeps
        your Latin letters and the search reads them the same way.
        <em>Beta Code help</em>, under Try on the search page, lists every
        letter and mark.
      </p>
      <p>
        <em>Keyboard</em>, also beside the Greek box, opens a Greek keyboard on
        the screen. Type a vowel, then press a mark, and the mark joins the
        vowel.
      </p>
      <p>
        You may leave the marks off: the search ignores accents, breathings, and
        capitals. Turn on <em>Accents</em>, under the Greek box, to match the
        marks exactly. Then <span lang="grc">λόγος</span> and
        <span lang="grc">λογός</span> are different searches, and a word typed
        without marks finds only words printed without them.
      </p>
    </section>

    <section id="wildcards">
      <h2><span class="gh-n" aria-hidden="true">{num('wildcards')}</span>Wildcards</h2>
      <p class="guide-q">Use this when you know how a word begins but not how it ends.</p>
      <p>
        End a word with <code>*</code> and it stands for whatever follows. With
        Form set to <em>Only as I typed it</em>, <code>fron*</code> reaches
        {n(wildcard?.fron)} different spellings across the works:
        <span lang="grc">φρόνησις</span>, <span lang="grc">φρόνιμος</span>,
        <span lang="grc">φρονεῖν</span>, and the rest of that family at once.
        Since Greek marks a word's job at the end, one wildcard gathers the whole
        paradigm. Under <em>Any form of this word</em>, the search goes further
        and adds every other form of the words those spellings belong to.
      </p>
      <p>
        A wildcard reaches further the more text you give it. In the
        <em>Republic</em> alone, <code>l*</code> reaches
        {n(wildcard?.republicL)} different spellings; across all
        {n(corpus.works)} works it reaches {n(wildcard?.l)}, out of
        {n(wildcard?.distinct)} in the corpus. The search counts places, not
        spellings, so it answers <code>l*</code> with passages, not with a word
        count.
      </p>
      <p>
        A star can also stand inside a word, and <code>?</code> stands for
        exactly one letter. <code>l*s</code> is every word that begins with
        <span lang="grc">λ</span> and ends with <span lang="grc">ς</span>,
        {n(wildcard?.lS)} different spellings. <code>log?s</code> finds
        <span lang="grc">λόγος</span> but not <span lang="grc">λόγους</span>,
        which has two letters in that place. The pattern must match the whole
        word, so a star in the middle never quietly becomes "every word
        beginning λ".
      </p>
      <p>
        Greek also takes <code>.</code> for one letter, <code>+</code> for one or
        more of the letter before, <code>[ ]</code> for one of several letters
        (<code>[^ ]</code> for any letter but those), <code>( | )</code> for
        either of two, and <code>^</code> and <code>$</code> for the start and
        end of the word. <code>(φιλ|σοφ)ια</code> finds both
        <span lang="grc">φιλία</span> and <span lang="grc">σοφία</span>.
      </p>
      <p class="guide-note">
        A star at the start of a word depends on how you type it. In Greek
        letters it is a wildcard: <code>*ικος</code> finds every word ending in
        <span lang="grc">-ικος</span>. In Beta Code a star before a letter makes
        a capital, so there you write the ending as <code>.*ikos$</code>. Beta
        Code also reads <code>( ) | +</code> as marks, so groups and alternatives
        need Greek letters. In English a leading star is always a wildcard:
        <code>*ness</code> finds happiness and goodness.
      </p>
      <h3>Running text</h3>
      <p>
        Set Form to <em>Running text</em> and the search reads the Greek as one
        stream of letters, across the breaks between words. <code>λογ</code>
        finds <span lang="grc">λόγος</span> and <span lang="grc">ἀναλογία</span>:
        the letters wherever they stand, at the start of a word or inside one.
        Here <code>.</code> is one letter, <code>.*</code> any run of letters, and
        <code>|</code> either of two. Each break between words counts as one
        space, so you can search across words too. Turn on
        <em>Punctuation</em> to match the stops as well: <code>,</code>
        <code>.</code> <code>;</code> and <code>·</code>.
      </p>
    </section>

    <section id="lemma">
      <h2><span class="gh-n" aria-hidden="true">{num('lemma')}</span>Lemma</h2>
      <p class="guide-q">Use this when you want one dictionary word, in every form, and nothing else.</p>
      <p>
        <em>Any form of this word</em> already works out the dictionary word from
        whatever form you type. Lemma is for when you would rather choose it
        yourself. Turn on <em>Lemma</em>, under the Greek box, and the box asks
        for a dictionary word. Start typing, and a list of <em>Dictionary
        words</em> opens: the headword, a short meaning, and how often it
        occurs. Pick the one you mean. The search then finds every form of that
        word and no other: no spelling that merely looks like it, and no other
        word that one of its forms could also belong to.
      </p>
      <p>
        Typing <span lang="grc">ψυχ</span> offers <span lang="grc">ψυχή</span>
        first, as the commonest, then the other words that begin that way, such
        as <span lang="grc">ψυχρός</span>, so you choose rather than guess. The
        list holds {n(pickerKeys)} entries, one for every word the search can
        find. A term set to <em>any form</em> in <a href="#combo">Proximity</a>
        picks from the same list.
      </p>
      <p class="guide-note">
        The search ignores accents, so words that differ only by an accent, such
        as <span lang="grc">ὅρος</span> and <span lang="grc">ὄρος</span>, are one
        entry in the list, and the list says that it cannot separate them.
      </p>
    </section>

    <section id="variants">
      <h2><span class="gh-n" aria-hidden="true">{num('variants')}</span>Word endings</h2>
      <p class="guide-q">
        Use this when you know a phrase but want every form of it, not just the
        one you typed.
      </p>
      <p>
        An exact phrase search finds only the version you typed. Search two or
        more Greek words and a button appears under the count:
        <em>Find this phrase in any inflection</em>. It works out which
        dictionary word each of your words belongs to, then looks for every form
        of those words standing in the order you gave.
      </p>
      <p>
        The phrase index shows how much that gathers.
        <span lang="grc">τὸ καλόν</span> ("the beautiful") stands
        {n(theBeautiful?.count)} times as those exact letters, in
        {n(theBeautiful?.works)} works. Read as dictionary words,
        <span lang="grc">ὁ καλός</span>, which gathers
        <span lang="grc">τοῦ καλοῦ</span>, <span lang="grc">τῷ καλῷ</span>,
        <span lang="grc">τῶν καλῶν</span>, and the rest, it stands
        {n(theBeautifulLemma?.count)} times, in {n(theBeautifulLemma?.works)}. To
        find those yourself you would have to know that
        <span lang="grc">τό</span>, <span lang="grc">τοῦ</span>, and
        <span lang="grc">τῷ</span> are one word. The tool knows it for you.
      </p>
      <p class="guide-note">
        It invents nothing. <span lang="grc">πάνυ μὲν οὖν</span> ("certainly")
        stands {n(certainly?.count)} times as written and
        {n(certainlyLemma?.count)} times read as dictionary words: those three
        words take one form only, so there is nothing to gather. A tool that
        always found more would tell you nothing.
      </p>
    </section>

    <section id="english">
      <h2><span class="gh-n" aria-hidden="true">{num('english')}</span>English searches</h2>
      <p class="guide-q">Use this to find a word in the translations, in any of its forms.</p>
      <p>
        Type in the English box. An English search finds a word in all its forms
        by default: a plural or possessive finds its singular, and back. In the
        translations here "soul" stands {n(soul.one)} times, and "souls" and
        "soul's" {n(soul.forms)} times more. Form set to <em>Any form of this
        word</em> finds them all; <em>Only as I typed it</em> finds the one
        spelling you gave. Irregular plurals are known too: "man" finds "men",
        "statesman" finds "statesmen".
      </p>
      <p>
        Match works as it does for Greek. <em>All words</em> wants every word
        somewhere in the passage, <em>Any word</em> at least one of them, and
        <em>Exact phrase</em> the words in a row, in your order. A phrase is
        matched as whole words, so "the good" does not find "they" or
        "goodness". A hyphenated word, "self-control", is found as its words
        standing together, and a word printed with an accent is found when you
        type plain letters.
      </p>
      <h3>Every translation</h3>
      <p>
        The indexed English is the Loeb translation, by {n(englishTranslators)}
        translators across the works. {n(jowettWorks.length)} works also carry
        Benjamin Jowett's translation. An English search looks in every
        translation of a work, and asks each separately. A passage that several
        translations match is one hit: the Greek once, and one translation's
        English. Under it stand the names of the translators whose words matched.
        Click a name to read that translation of the passage instead.
      </p>
      <p>
        <em>Works with hits</em>, beside the results, shows each work with its
        translations under it, and counts the sections in each. Choose a work or
        a translator to see only its hits, and choose it again to see them all. A
        Jowett passage is placed at the section where its speech begins, since
        his translation is matched to Plato's speeches, not to the Stephanus
        sections.
      </p>
      <h3>Greek and English at once</h3>
      <p>
        Type in both boxes and a switch appears between them, <em>Hits
        match</em>, with three settings: <em>and</em>, <em>and/or</em>, and
        <em>or</em>. Each counts sections.
      </p>
      <ul>
        <li>
          <strong>and</strong> (<em>Both languages</em>) keeps a section only if
          it holds both terms: your Greek and your English.
        </li>
        <li>
          <strong>and/or</strong> (<em>Either or both</em>) keeps a section with
          either term or both. A new search opens on this setting.
        </li>
        <li>
          <strong>or</strong> (<em>One language, not both</em>) keeps a section
          only if one language has hits and the other has none. It is the
          exclusive or.
        </li>
      </ul>
      <p>
        Under the count, a search in both boxes lists three rows, <em>Greek and
        English</em>, <em>Greek only</em>, and <em>English only</em>, each with
        its number of sections. The rows that the switch counts are the ones lit.
      </p>
      <p class="guide-note">
        A link to a Greek and English search written before the switch had three
        settings carries no setting, and still means <em>and</em>.
      </p>
    </section>

    <section id="grammatical">
      <h2><span class="gh-n" aria-hidden="true">{num('grammatical')}</span>Search by grammar</h2>
      <p class="guide-q">
        Use this to find a kind of word rather than a particular word.
      </p>
      <p>
        Every Greek word here carries a grammatical description: its case,
        number, tense, and so on. You can search those descriptions instead of
        the spelling. In <a href="#combo">Proximity</a>, set a term's Kind to
        <em>by grammar</em>. Choose a <em>word class</em>: a declined word, a
        verb, or a class that takes neither case nor tense, such as a particle or
        a preposition. Then rows open for what that class has. A declined word
        has Case, Number, Gender, Degree, and Part of speech (noun, adjective,
        article, or pronoun); a verb has Tense, Mood, Voice, Person, and Number,
        and a participle adds Case, Number, and Gender. Pick a value in as many
        rows as you like; a word must match them all. You need not know how any
        of these forms are spelled.
      </p>
      <p>
        The part of speech is the class that LSJ gives the word, where it gives
        one. Where it does not, the Cambridge Greek Lexicon decides, and then
        Morpheus. Particles follow Smyth: an adverb, a conjunction, or both, as
        his grammar classes them.
      </p>
      <p>
        Grammar searched across all of Plato would not be a question: there are
        {n(genPlFem?.total)} genitive plural feminines in the works, and a list
        of them tells you about Greek rather than about Plato. So a grammar term
        runs on its own only <strong>once something narrows it</strong>: fewer
        works under In, a speaker, or a word near or not near it. Ask without
        any, and the page offers <em>Choose works</em>, <em>Choose speakers</em>,
        and <em>Add a word near or not near</em> instead of results.
        <a href={tryGrammar}>Aorist passive participles in the
        <em>Phaedo</em></a> is a question; <em>a word near a verb in the
        optative</em> is another.
      </p>
      <p>
        Grammar also sorts results you already have. Set Group by to <em>By
        grammar</em> and the hits fall into groups by their analysis, with a
        <em>Grammar</em> list beside them: tick a case or a tense there to keep
        only those hits.
      </p>
      <h3>Why some results say "one of several readings"</h3>
      <p>
        The same Greek letters can be two different forms. When that happens the
        hit shows what is left open, rather than choosing for you.
      </p>
      <p>
        Plato's works hold {n(optative?.total)} optatives. Of those,
        {n(optative?.certain)} have one possible reading; a hit on any of the
        rest comes back marked, because you could read those letters another way.
        The mark shows no flaw in the search. It reports a fact about the Greek.
      </p>
      <p>
        A clearer case: of the {n(genDual?.total)} genitive duals (the dual is
        the form for pairs), {genDual?.certain === 0
          ? <>not one is certain</>
          : <>only {n(genDual?.certain)} are certain</>}. In the dual, genitive
        and dative share one ending. The search cannot tell them apart because
        Greek does not, and it says so instead of deciding for you.
      </p>
    </section>

    <section id="combo">
      <h2><span class="gh-n" aria-hidden="true">{num('combo')}</span>Proximity</h2>
      <p class="guide-q">
        Use this to find where two ideas are discussed together.
      </p>
      <p>
        Proximity finds passages where two or more terms stand close together.
        Press <em>Proximity</em>, beside Search, to open the editor. Search either
        word alone and you get every passage that holds it; ask for both together
        and you get the passages where Plato is doing something with the pair.
        <a href={tryNear}><span lang="grc">ἀρετή</span> near
        <span lang="grc">ἐπιστήμη</span></a> is one such question.
      </p>
      <h3>The editor</h3>
      <ul>
        <li>
          <em>Kind</em>: what a term is. <em>any form</em> is a dictionary word
          in every form, picked from the list (see <a href="#lemma">Lemma</a>);
          <em>as typed</em> is one spelling; <em>exact phrase</em> is several
          words in a row, such as <span lang="grc">ὦ Σώκρατες</span>;
          <em>by grammar</em> is a description (see
          <a href="#grammatical">Search by grammar</a>).
        </li>
        <li>
          <em>Distance</em>, on Term 1's row: how close is close. Within 5 words
          at first; you can set it as high as 50, or choose <em>the same
          line</em> of Greek.
        </li>
        <li>
          <em>Relation</em>, on every term after the first: <em>near</em>,
          <em>before</em>, <em>after</em>, or <em>not near</em>, and the term it
          is measured from. Usually that is Term 1, but it can be any earlier
          term.
        </li>
        <li>
          <em>and</em> or <em>or</em>, before each term after the first. A term
          joined by <em>or</em> stands in for the one before it, and either will
          do: <a href={tryOr}>either <span lang="grc">ἡδονή</span> or
          <span lang="grc">λύπη</span> near <span lang="grc">ἀρετή</span></a>. It
          takes that term's relation, and its row says so.
        </li>
        <li>
          <em>Add term</em> and <em>Remove</em>. A search holds up to four terms.
        </li>
        <li>
          <em>In this order</em>: every term must appear in the order you gave.
          Once any term says before or after, those settle the order, and the
          switch stays on.
        </li>
        <li>
          <em>Keep hits that cross from one speaker to the next</em>: on at
          first, since a question and its answer belong together. Turn it off,
          and a window must stay inside one speech. The results then carry a
          <em>Within one speech</em> chip, which undoes the setting (see
          <a href="#speaker">Who is speaking</a>).
        </li>
      </ul>
      <p>
        Each term must fall within the distance of the term it is measured from.
        The distance is counted between those two words alone, not across the
        whole group, so three terms within 10 words can span more than 10 words
        in all. <em>Not near</em> turns that round: the passage must have no such
        word within the distance of its term.
        <a href={tryNot}><span lang="grc">ἡδονή</span> before
        <span lang="grc">ἀρετή</span>, with <span lang="grc">λύπη</span> not
        near</a> asks for pleasure without pain.
      </p>
      <p>
        Once a proximity search has run, it reads as one sentence above the
        editor, with <em>Turn off</em>, <em>Close</em>, and <em>Guide</em> under
        it (<em>Change</em> in place of Close when the editor is shut). A change
        in the editor is not searched until you press its <em>Search</em>.
      </p>
      <p class="guide-note">
        A match never crosses from one book into the next, however wide the
        distance: the last words of one book and the first of the next are not
        near each other in any useful sense.
      </p>
    </section>

    <section id="speaker">
      <h2><span class="gh-n" aria-hidden="true">{num('speaker')}</span>Who is speaking</h2>
      <p class="guide-q">
        Use this to hear one voice at a time.
      </p>
      <p>
        Plato's dialogues name their speakers, and the Greek text marks each
        change of speaker. So a search can be held to one mouth:
        <span lang="grc">ἀρετή</span> as Socrates uses it, and separately as
        everyone else does. Under the form, a <em>Spoken by</em> row, laid
        out like the <em>In</em> row, offers <em>anyone</em> and <em>choose
        speakers…</em>. Choose speakers, then pick <em>Only these speakers</em>
        or <em>Anyone but these</em>, and tick the names. The cast offered is read from the works
        you have selected, most talkative first, with the number of speeches
        beside each name. The filter applies to every kind of search on the page,
        and each Greek hit is labelled with its speaker.
      </p>
      <p>
        Across the {n(speakers?.labelled)} works that carry speaker labels there
        are {n(speakers?.turns)} speeches by {n(speakers?.distinct)} named
        speakers; {n(speakers?.socrates)} of those speeches are Socrates'.
      </p>
      <h3>What it holds to, and what it cannot</h3>
      <ul>
        <li>
          A <strong>Greek</strong> hit is held to the word: it is kept only if
          the speech it stands in belongs to a chosen speaker.
        </li>
        <li>
          An <strong>English</strong> hit is held to the passage. The translation
          is aligned to the Stephanus section, not to the word, so an English
          match is kept when someone you chose speaks anywhere in that section.
          Expect the English side to be a little generous.
        </li>
        <li>
          In <a href="#combo">Proximity</a>, every term must fall in a chosen
          speaker's speech. By default a window may run from one speech into the
          next. Turn off <em>Keep hits that cross from one speaker to the
          next</em> and it must stay inside one speech. On a phone, the Filter
          list shows <em>Within one speech</em> under This search, with a ×
          that turns the switch back on.
        </li>
        <li>
          Some works
          {speakers?.unlabelledTitles.length
            ? `(${list(speakers.unlabelledTitles)})`
            : ''}
          carry no speaker labels in the Greek text. Where a narrator reports who
          spoke inside the prose, as in the <em>Republic</em>, nothing in the
          narration can be attributed to a speaker. A filtered search leaves
          these works out and says so under the results.
          <em>Anyone but Socrates</em> does not admit them either: a word nobody
          is marked as saying is not known to be someone else's.
        </li>
        <li>
          The reported dialogues
          {speakers?.narratedTitles.length
            ? `(${list(speakers.narratedTitles)})`
            : ''}
          are labelled only at the frame — the narrator and whoever asked for the
          story — so every word of the conversation inside would count as the
          narrator's. They are left out too, and named under the results.
        </li>
        <li>
          Words before a work's first speaker label have no speaker and fail both
          modes.
        </li>
      </ul>
      <p class="guide-note">
        The speaker names are the ones the reader prints beside each turn, taken
        from the OCT sigla. Where a translation names a speaker differently
        ("Meno's Boy" for <span lang="grc">ΠΑΙ.</span>), it is the reader's name
        that appears here.
      </p>
    </section>

    <section id="results">
      <h2><span class="gh-n" aria-hidden="true">{num('results')}</span>Reading the results</h2>
      <p class="guide-q">Use this to make a long list of hits answer your question.</p>
      <p>
        The bar over the results reads, for example, "343 sections · 463 hits".
        The first number counts Stephanus sections: each section with a hit
        counts once, however many hits it holds. The second counts hits where a
        hit is one thing, a Greek word, or an English word in a search where no
        work answers in more than one translation. Where several translations
        answer, the bar gives sections alone, since a hit count would add up
        translators. Each result shows its Stephanus page and section, the Greek
        with the match marked, and the English under it. Click a Greek word in a
        hit to see its dictionary entry: the headword, its meaning, how the form
        parses, and how often it appears in Plato.
      </p>
      <ul>
        <li>
          <em>Group by</em>: <em>By work</em>, with a heading for each; <em>By
          form</em>, each spelling apart; or <em>By grammar</em>. A search offers
          only the groupings that fit it.
        </li>
        <li>
          <em>Sort</em>: <em>Stephanus order</em>, <em>Works A–Z</em>,
          <em>Forms A–Z</em>, or <em>Commonest form first</em>. A sort orders the
          page you are on; it never moves a hit to another page.
        </li>
        <li>
          <em>Context</em>: <em>1 line</em>, <em>3 lines</em>, or the <em>Whole
          section</em> each hit stands in.
        </li>
        <li>
          <em>Per page</em>: 20, 40, or 100 hits. The 100 page shows each hit as
          its citation and the words around the first match; click one to open
          the passage.
        </li>
      </ul>
      <p>
        A page never breaks inside a section: a page that ends short ends between
        two sections.
      </p>
      <p>
        Beside the results, <em>Works with hits</em> counts the sections in each
        work, most first ("63 sect."). <em>Translations</em> counts the English
        hits in each translation. <em>Forms</em> lists every spelling the search
        found, with its count: untick the ones you do not want and press
        <em>Apply</em>. <em>Phrases</em> lists the English phrases around the
        hits and sets any of them aside. <em>Export results as CSV</em> gives you
        the whole list as a spreadsheet. <em>Save search</em> keeps the search in
        this browser, and <a href={`${base}/saved`}>Saved searches</a> lists
        them.
      </p>
      <p class="guide-note">
        A search is written into the address bar as you run it, so you can
        bookmark it, send it to someone, or step back through your searches with
        the browser's back button.
      </p>
    </section>

    <section id="phrases">
      <h2><span class="gh-n" aria-hidden="true">{num('phrases')}</span>The phrase index</h2>
      <p class="guide-q">
        Use this when you do not yet know what to look for.
      </p>
      <p>
        Search answers "where does this occur?" The
        <a href={`${base}/phrases`}>phrase index</a> answers a different
        question: <em>what does Plato repeat?</em> It lists every phrase of two to
        five words that appears at least twice anywhere in the works:
        {n(corpus.formPhrases)} of them as written, {n(corpus.lemmaPhrases)} when
        forms of the same word count together, and {n(corpus.englishPhrases)} in
        the English translations. (If you have met the term, these are what
        linguists call n-grams.)
      </p>
      <p>
        This matters because a dialogue is built as much out of set phrases as
        out of single words, and no word search will show them to you:
        <span lang="grc">ἦν δ’ ἐγώ</span> ("said I", Socrates narrating) occurs
        {n(said?.count)} times across {n(said?.works)} works;
        <span lang="grc">πάνυ μὲν οὖν</span> ("certainly") {n(certainly?.count)}
        times; <span lang="grc">ὡς ἔπος εἰπεῖν</span> ("so to speak")
        {n(soToSpeak?.count)} times in {n(soToSpeak?.works)}. Not one of those is
        a word. Each is a habit of thought, and browsing is the only way to meet
        them.
      </p>
      <h3>Reading a row</h3>
      <p>
        Every row is one phrase and four numbers. This is the row for
        <span lang="grc">ἦν δ’ ἐγώ</span>:
      </p>
      <figure class="anatomy">
        <div class="anatomy-row">
          <span class="anatomy-phrase">
            <span lang="grc">ἦν δ’ ἐγώ</span>
            <small>hn d' egw</small>
          </span>
          <span class="anatomy-cell"><b>{n(said?.words)}</b><small>Words</small></span>
          <span class="anatomy-cell"><b>{n(said?.count)}</b><small>Count</small></span>
          <span class="anatomy-cell"><b>{n(said?.works)}</b><small>Works</small></span>
          <span class="anatomy-cell score"><b>{score(said?.score)}</b><small>Score</small></span>
        </div>
        <dl class="anatomy-key">
          <dt>Words</dt>
          <dd>How many words long. Two to five.</dd>
          <dt>Count</dt>
          <dd>How often it occurs in the whole corpus.</dd>
          <dt>Works</dt>
          <dd>How many of the {n(corpus.works)} works it appears in.</dd>
          <dt>Score</dt>
          <dd>
            Distinctiveness: how much more often the phrase occurs than the
            commonness of its words on their own would lead you to expect. It
            orders the list and removes nothing.
          </dd>
        </dl>
      </figure>

      <h3>The same phrase, counted two ways</h3>
      <p>
        The <em>As written</em> and <em>Dictionary words</em> buttons at the top
        of the page read the same corpus two ways, and it is worth seeing what
        changes. <em>As written</em> counts the letters on the page: change one
        ending and it is a different row. <em>Dictionary words</em> counts the
        words behind the letters, so every inflection of the phrase gathers into
        a single row. Either takes the phrase as it stands on the page: type
        <span lang="grc">ἦν δ’ ἐγώ</span> and the second finds it under
        <span lang="grc">ἠμί δέ ἐγώ</span>, which is where it is stored, and
        tells you it read the words that way. <em>English</em> does the same for
        the translations.
      </p>
      <figure class="anatomy">
        <div class="anatomy-row">
          <span class="anatomy-phrase">
            <span lang="grc">ἦν δ’ ἐγώ</span>
            <small>as written</small>
          </span>
          <span class="anatomy-cell"><b>{n(said?.words)}</b><small>Words</small></span>
          <span class="anatomy-cell"><b>{n(said?.count)}</b><small>Count</small></span>
          <span class="anatomy-cell"><b>{n(said?.works)}</b><small>Works</small></span>
          <span class="anatomy-cell score"><b>{score(said?.score)}</b><small>Score</small></span>
        </div>
        <div class="anatomy-row">
          <span class="anatomy-phrase">
            <span lang="grc">ἠμί δέ ἐγώ</span>
            <small>dictionary words</small>
          </span>
          <span class="anatomy-cell"><b>{n(saidLemma?.words)}</b><small>Words</small></span>
          <span class="anatomy-cell"><b>{n(saidLemma?.count)}</b><small>Count</small></span>
          <span class="anatomy-cell"><b>{n(saidLemma?.works)}</b><small>Works</small></span>
          <span class="anatomy-cell score"><b>{score(saidLemma?.score)}</b><small>Score</small></span>
        </div>
      </figure>
      <p>
        The dictionary row is never the smaller of the two: it gathers the
        formula's other endings in with it. It also asks more of you: the same
        dictionary words can be assembled into phrases that are not the one you
        wanted, and the tool cannot tell the difference. Use it to discover what
        you would otherwise miss, then read as written to see what you have.
      </p>
      <p class="guide-note">
        The score changes between the two rows for what is, in the main, the same
        expression. Nothing has weakened. Distinctiveness measures surprise
        against the words a phrase is made of, and the two readings are made of
        different words: <span lang="grc">ἠμί</span> and
        <span lang="grc">δέ</span> are commoner than the exact shapes
        <span lang="grc">ἦν</span> and <span lang="grc">δ’</span>, so a phrase
        built from them is less surprising.
      </p>

      <h3>Reading the list</h3>
      <ul>
        <li>
          <em>Sort</em> starts at <em>distinctiveness</em>. It asks whether a
          phrase occurs more often than the commonness of its words would lead
          you to expect. Sort by <em>frequency</em> instead and you see the
          grammar of Greek rather than the thought of Plato.
        </li>
        <li>
          <em>Length</em>, <em>At least … times</em>, and <em>In</em> narrow the
          list by phrase length, by how often a phrase occurs, and by which work
          it appears in. A box for the start of a phrase finds one by its first
          words. Sorting never removes anything; it only changes the order.
        </li>
        <li>
          <strong>The English list</strong> indexes the Loeb translation of each
          work — {n(englishTranslators)} translators working to one editorial
          standard rather than a different hand for every work. So an English
          phrase that recurs across several works is more likely to be Plato
          recurring than one translator's habit, and the <em>Works</em> column is
          the thing to read. It is still English: a phrase in this list is a place
          to look, not evidence about the Greek.
        </li>
      </ul>
      <p>
        Click any phrase to see every place it occurs, grouped by work, each one
        linked to that passage in the reader.
      </p>
      <h3>A way to use it</h3>
      <p>
        Pick the work you are reading and a phrase length of four or five, then
        sort by distinctiveness. You get that work's set expressions, often the
        working vocabulary of its argument, including phrases no glossary would
        have sent you to look for. Click one to see where else in Plato it stands.
      </p>
    </section>

    <section id="honesty">
      <h2><span class="gh-n" aria-hidden="true">{num('honesty')}</span>What these tools cannot tell you</h2>
      <p>
        All of this depends on a word-by-word grammatical description of the
        Greek, and that description is often uncertain. Where it is, these tools
        say so rather than choose an answer and present it as fact. The limits
        worth knowing:
      </p>
      <ul>
        <li>
          A result marked as having several possible readings comes from a form
          the description cannot settle. Of the {n(optative?.total)} optatives,
          {n(optative?.certain)} are settled and the rest are not.
        </li>
        <li>
          Searches ignore accents unless you turn on <em>Accents</em>. And of the
          {n(corpus.surfaceForms)} spellings the corpus knows,
          {n(corpus.ambiguousForms)} belong to more than one dictionary word, so
          a search for one word in all its forms can bring back another word that
          shares a spelling.
        </li>
        <li>
          The phrase index shows Greek without accents, because it does not
          record them. We do not guess them.
        </li>
        <li>
          Where a speech begins is worked out from the text, and in a few places
          only to the nearest line of Greek rather than to the exact word. Any
          search that turns on speaker turns says so when those works are
          involved.
        </li>
        <li>
          An exact phrase search cannot match across the boundary between two
          Stephanus sections; the phrase index and the proximity search can. So
          the index will sometimes count a phrase once more than an exact search
          finds it.
        </li>
        <li>
          None of these tools reads Greek. They match forms and count them. What
          a passage means remains your work.
        </li>
      </ul>
      <p class="guide-note">
        The Greek text is the TLG. The grammatical descriptions come from
        Morpheus, by way of Diogenes; the dictionary is Liddell–Scott–Jones.
      </p>
    </section>

