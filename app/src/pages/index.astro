---
import { readFileSync } from 'node:fs';
import { AUTHENTICITY_LABEL, SHELVES, START_HERE, getWork, workLanding, type Work } from '@shared/lib/works';
import { greekNumeral } from '@shared/lib/numerals';
import { inscriptionCaps } from '@shared/lib/inscription';
import ThemeInit from '../components/ThemeInit.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Inscription from '../components/Inscription.astro';
import Pwa from '../components/Pwa.astro';
import Fonts from '../components/Fonts.astro';
import CommandPalette from '@shared/components/CommandPalette.svelte';
import { jsonLdSafe } from '../lib/jsonld';
import '@shared/styles/global.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Home-page SEO + social card (absolute URLs need Astro.site, set in config).
const homeDescription =
  'Read the complete works of Plato with the original Greek and a facing' +
  ' English translation, side by side — with click-to-parse morphology,' +
  ' dictionary lookup, Stephanus citation, and full-text search across the corpus.';
const canonical = Astro.site ? new URL(`${base}/`, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(`${base}/og-default.png`, Astro.site).href : undefined;
// Resolve the corpus taxonomy into per-shelf view models. Each shelf holds a
// flat list of cards. A card is an existing work (clickable → its landing
// page) or a "coming soon" placeholder (works not yet added). Each card row
// becomes a single tappable card; the editions/translations live on the
// work's landing page (/<work>).
type Card =
  | { kind: 'work'; work: Work }
  | { kind: 'soon'; title: string };

interface ShelfView {
  numeral: string;
  title: string;
  count: number;   // total cards (works + soon)
  cards: Card[];
}

const toCards = (ws: { id?: string; title?: string }[]): Card[] =>
  ws.flatMap((cw) => {
    const w = cw.id ? getWork(cw.id) : undefined;
    if (w) return [{ kind: 'work', work: w } as Card];
    if (cw.title) return [{ kind: 'soon', title: cw.title } as Card];
    return [];
  });

const shelves: ShelfView[] = SHELVES.map((s) => {
  const cards = toCards(s.works);
  return { numeral: s.numeral, title: s.title, count: cards.length, cards };
});

// "Begin with" — a curated line above the shelves (see START_HERE in
// shared/lib/works.ts). These works also keep their normal place in their
// thematic shelf below; this row is an additive pointer for newcomers, not an
// extra division.
const startHere: Work[] = START_HERE.map((id) => getWork(id)).filter((w): w is Work => Boolean(w));

// Each work's Stephanus span in the register ("57–118"): the first page of
// its first book to the last page of its last, from the build's sections.json.
const spanOf = (w: Work): string => {
  try {
    const secs: Record<string, { page: number }[]> =
      JSON.parse(readFileSync(`public/data/${w.id}/sections.json`, 'utf-8'));
    const first = secs['1']?.[0]?.page;
    const last = secs[String(w.books)]?.at(-1)?.page;
    return first && last ? `${first}–${last}` : '';
  } catch { return ''; }
};

// Structured data: identify the site (WebSite) and enumerate every built work as
// an ItemList of CreativeWorks linking to its landing page. This tells Google the
// home page is the hub for the whole corpus, reinforcing the per-work pages that
// carry the long-tail "<work> greek & english" queries. Absolute URLs need
// Astro.site (set in config); emitted only when present.
const builtWorks = shelves.flatMap((s) =>
  s.cards.filter((c): c is Extract<Card, { kind: 'work' }> => c.kind === 'work'),
);
const structuredData = Astro.site
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: 'The Plato Reader',
        alternateName: 'Plato in Greek & English',
        url: new URL(`${base}/`, Astro.site).href,
        description: homeDescription,
      },
      {
        '@context': 'https://schema.org',
        '@type': 'ItemList',
        name: 'The Complete Works of Plato',
        numberOfItems: builtWorks.length,
        itemListElement: builtWorks.map((c, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: c.work.title,
          url: new URL(`${base}${workLanding(c.work.id)}/`, Astro.site).href,
        })),
      },
    ]
  : null;
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <!-- TODO: register this property in Google Search Console and add its
       verification token here (a sibling reader's token was intentionally
       removed from this file — it belongs to a different GSC property). -->
  <ThemeInit />
  <title>The Plato Reader — Complete Works in Greek &amp; English</title>
  <meta name="description" content={homeDescription} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content="The Plato Reader — Complete Works in Greek & English" />
  <meta property="og:description" content={homeDescription} />
  <meta property="og:site_name" content="The Plato Reader" />
  {canonical && <meta property="og:url" content={canonical} />}
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="The Plato Reader — Complete Works in Greek & English" />
  <meta name="twitter:description" content={homeDescription} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  {structuredData && structuredData.map((sd) => (
    <script type="application/ld+json" set:html={jsonLdSafe(sd)} />
  ))}
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="icon" href={`${base}/favicon.png`} type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} sizes="180x180" />
  <Fonts />
  <Pwa />
</head>
<body class="home">
  <CommandPalette client:load />
  <SiteNav current="works" />
  <main class="corpus">
    <section class="hero">
      <div class="hero-grid">
        <Inscription text="ΠΛΑΤΩΝΟΣ ΑΠΑΝΤΑ ΤΑ ΣΩΖΟΜΕΝΑ" cols={8} accentRows={1} muted={[14, 16]} />
      </div>
      <div class="hero-text">
        <h1>The Complete Works of Plato in Greek and English</h1>
        <p class="lead">Parallel Greek-English editions of Plato. <span class="say-click">Click</span><span class="say-tap">Tap</span> any Greek word to parse it and see its definition. Search the corpus in Greek and English.</p>
        <form class="home-search" id="home-search" action={`${base}/search`} method="get" role="search">
          <svg class="hs-glass" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.2-4.2"/></svg>
          <input id="home-q" type="search" name="q" placeholder="φάρμακον, justice, ἀρετή …" aria-label="Search the corpus, in Greek or English" autocomplete="off" autocorrect="off" autocapitalize="none" spellcheck="false" />
          <button type="submit">Search</button>
        </form>
        <p
          class="resume-line"
          id="resume-line"
          hidden
          data-works={JSON.stringify(Object.fromEntries(
            builtWorks.map((c) => [c.work.id, { title: c.work.title, labels: c.work.bookLabels }]),
          ))}
        >Continue · <a id="resume-card" href="#"><span id="resume-meta"></span> →</a></p>
      </div>
    </section>

    <nav class="begin" aria-label="Begin with">
      <span class="begin-label">Begin with</span>
      {startHere.map((w) => <a href={`${base}${workLanding(w.id)}`}>{w.title}</a>)}
    </nav>

    <section class="register" aria-labelledby="works-heading">
      <h2 id="works-heading" class="sr-only">All works, by theme</h2>
      {shelves.map((s) => (
        <section class="cat">
          <h3 class="cat-head">
            <button class="cat-toggle" type="button" aria-expanded="false">
              <span class="cat-num">{greekNumeral(Number(s.numeral))}</span>
              <span class="cat-title">{s.title}</span>
              <span class="cat-chev" aria-hidden="true"></span>
            </button>
          </h3>
          <ul class="names">
            {s.cards.map((c) => (
              c.kind === 'work' ? (
                <li>
                  <a class="nm" href={`${base}${workLanding(c.work.id)}`}>
                    <span class="nm-gr" lang="grc">{inscriptionCaps(c.work.greekTitle ?? c.work.title)}</span>
                    <span class="nm-en">{c.work.title}</span>
                    <span class="nm-pp">{spanOf(c.work)}{c.work.authenticity && c.work.authenticity !== 'genuine' &&
                      <b class="nm-dub">{AUTHENTICITY_LABEL[c.work.authenticity]}</b>}</span>
                  </a>
                </li>
              ) : (
                <li>
                  <span class="nm soon" aria-disabled="true">
                    <span class="nm-en">{c.title}</span>
                    <span class="nm-pp">Coming soon</span>
                  </span>
                </li>
              )
            ))}
          </ul>
        </section>
      ))}
    </section>
  </main>
  <SiteFooter />
  <style>
    body.home { background: var(--page-bg); color: var(--text); }
    .corpus { max-width: 1280px; margin: 0 auto; }

    /* Hero: the inscription grid (the title of Estienne's 1578 edition), then
       the headline, the introduction and the search field. */
    .hero {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      gap: 4.5rem;
      align-items: center;
      padding: 4rem 3.5rem 3.5rem;
    }
    .hero-grid { --cell-w: 4.625rem; --cell-h: 5.5rem; --cell-fs: 4.5rem; }
    .hero h1 {
      font-family: var(--font-english);
      font-weight: 400;
      font-size: 2.5rem;
      line-height: 1.2;
      margin: 0 0 1.125rem;
      text-wrap: balance;
    }
    .lead { font-size: 1.25rem; line-height: 1.55; margin: 0; }
    .say-tap { display: none; }
    .home-search {
      display: flex;
      align-items: center;
      gap: 0.875rem;
      height: 3.5rem;
      margin-top: 1.875rem;
      border-bottom: 2px solid var(--text);
      color: var(--text-mid);
    }
    .home-search:focus-within { border-bottom-color: var(--accent); }
    .hs-glass { flex-shrink: 0; }
    .home-search input {
      flex: 1;
      min-width: 0;
      border: none;
      background: transparent;
      font-family: var(--font-english);
      font-size: 1.3125rem;
      color: var(--text);
      outline: none;
    }
    .home-search input::placeholder { color: var(--text-mid); opacity: 1; }
    .home-search button {
      border: none;
      background: none;
      padding: 0.4rem 0;
      cursor: pointer;
      font-family: var(--font-caps);
      font-weight: 300;
      font-size: 0.75rem;
      letter-spacing: var(--caps-tracking);
      text-transform: uppercase;
      color: var(--text);
    }
    .home-search button:hover { color: var(--accent); }
    /* "Continue · Phaedo 58a →": the label in grey, the place a link. */
    .resume-line { margin: 1rem 0 0; font-size: 1rem; color: var(--text-mid); }
    .resume-line[hidden] { display: none; }
    .resume-line a {
      color: var(--text);
      text-decoration: none;
      border-bottom: 1px solid var(--text);
    }
    .resume-line a:hover { color: var(--accent); border-bottom-color: var(--accent); }

    /* "Begin with": the six START_HERE works on one ruled line. */
    .begin {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.6rem 1.75rem;
      padding: 1.375rem 3.5rem;
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      font-size: 1.375rem;
    }
    .begin-label {
      font-family: var(--font-caps);
      font-weight: 300;
      font-size: 0.75rem;
      letter-spacing: var(--caps-tracking);
      text-transform: uppercase;
      color: var(--accent);
    }
    .begin a {
      color: var(--text);
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 0.2em;
    }
    .begin a:hover { color: var(--accent); }

    /* The register: each theme heading (Greek numeral + title) above its
       works, five to a row — Greek title in capitals, English title, the
       Stephanus span, and a red-brown tag where authorship is doubted. */
    .register { display: grid; gap: 1.875rem; padding: 2rem 3.5rem 1.75rem; }
    .cat-head { margin: 0; font-weight: 400; font-size: 1.4375rem; line-height: 1.3; }
    .cat-toggle {
      display: flex;
      align-items: baseline;
      gap: 0.875rem;
      width: 100%;
      padding: 0;
      border: none;
      background: none;
      font: inherit;
      color: var(--text);
      text-align: left;
      cursor: pointer;
    }
    .cat-num {
      font-family: var(--font-caps);
      font-weight: 300;
      font-size: 1.125rem;
      letter-spacing: 0.1em;
      color: var(--accent);
    }
    .cat-chev { display: none; }
    .names {
      list-style: none;
      margin: 0.5rem 0 0;
      padding: 0.75rem 0 0;
      border-top: 1px solid var(--text);
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 0.75rem 1.625rem;
    }
    .nm { display: grid; gap: 0.1rem; color: var(--text); text-decoration: none; }
    .nm-gr {
      font-family: var(--font-caps);
      font-weight: 300;
      font-size: 0.9375rem;
      letter-spacing: 0.1em;
    }
    .nm-en { font-style: italic; font-size: 1.3125rem; line-height: 1.25; }
    .nm-pp {
      font-family: var(--font-caps);
      font-weight: 300;
      font-size: 0.75rem;
      letter-spacing: 0.06em;
      color: var(--text-mid);
      font-variant-numeric: tabular-nums;
    }
    .nm-dub {
      font-weight: 300;
      color: var(--accent-2);
      letter-spacing: 0.14em;
      text-transform: uppercase;
      margin-left: 0.5rem;
    }
    a.nm:hover .nm-en { color: var(--accent); }
    a.nm:focus-visible { outline: 2px solid var(--accent-light); outline-offset: 3px; }
    .nm.soon { color: var(--text-mid); }

    @media (max-width: 1180px) {
      .hero { gap: 3rem; padding: 3rem 2rem 2.75rem; }
      .hero-grid { --cell-w: 3.6rem; --cell-h: 4.3rem; --cell-fs: 3.5rem; }
      .begin, .register { padding-left: 2rem; padding-right: 2rem; }
      .names { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    }
    @media (max-width: 900px) {
      .hero { grid-template-columns: minmax(0, 1fr); gap: 2rem; }
      .names { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }
    /* Phones and small tablets: each theme opens on a tap (see the script). */
    @media (max-width: 47.99rem) {
      .cat:not([data-open]) .names { display: none; }
      .cat-chev {
        display: block;
        margin-left: auto;
        width: 0.5rem;
        height: 0.5rem;
        border-right: 1.5px solid var(--text-mid);
        border-bottom: 1.5px solid var(--text-mid);
        transform: rotate(45deg);
        transition: transform 0.15s ease;
        align-self: center;
      }
      .cat[data-open] .cat-chev { transform: rotate(225deg); }
    }
    @media (min-width: 48rem) {
      .cat-toggle { pointer-events: none; cursor: default; }
    }
    @media (max-width: 680px) {
      .hero { padding: 1.4rem 1.25rem 1.5rem; gap: 1.25rem; }
      .hero-grid { --cell-w: 1fr; --cell-h: 2.875rem; --cell-fs: 2.25rem; }
      .hero h1 { font-size: 1.9375rem; line-height: 1.14; margin-bottom: 0.75rem; }
      .lead { font-size: 1rem; }
      .say-click { display: none; }
      .say-tap { display: inline; }
      .home-search { height: 3rem; margin-top: 1.25rem; }
      .home-search input { font-size: 1.0625rem; }
      .begin { padding: 1.25rem; gap: 0.5rem 1rem; font-size: 1.1875rem; }
      .begin-label { flex: 1 1 100%; }
      .register { padding: 1.25rem; gap: 1.1rem; }
      .cat-head { font-size: 1.1875rem; }
      .cat-num { font-size: 1.1875rem; }
      .names { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.875rem 1.125rem; }
      .nm-gr { font-size: 0.75rem; letter-spacing: 0.12em; }
      .nm-en { font-size: 1.0625rem; }
      .nm-pp { font-size: 0.625rem; }
    }
  </style>

  <script>
    // "Continue · Phaedo 58a →" under the search field: shown only when the
    // reader has saved a recent position (localStorage — see
    // shared/lib/resume.ts), pointing back into the reader at the remembered
    // book + Stephanus section.
    import { lastRead } from '@shared/lib/resume';

    const line = document.getElementById('resume-line');
    const card = document.getElementById('resume-card') as HTMLAnchorElement | null;
    if (line && card) {
      const works: Record<string, { title: string; labels: string[] }> =
        JSON.parse(line.dataset.works || '{}');
      const last = lastRead((w) => w in works);
      if (last) {
        const w = works[last.work];
        const books = w.labels.length;
        const book = Math.min(Math.max(1, last.book), books);
        const bookBit = books > 1 ? ` ${w.labels[book - 1]}` : '';
        const citeBit = last.cite ? ` ${last.cite}` : '';
        card.querySelector('#resume-meta')!.textContent = `${w.title}${bookBit}${citeBit}`;
        const base = (import.meta.env.BASE_URL as string).replace(/\/$/, '');
        card.href = `${base}/${last.work}/book/${book}${last.cite ? `#${last.cite}` : ''}`;
        line.hidden = false;
      }
    }
  </script>

  <script>
    // The home search field hands its words to the search page: Greek letters
    // as a Greek query (?g=), anything else as English (?q=, which the search
    // page routes to its English box). An empty field goes nowhere.
    const form = document.getElementById('home-search') as HTMLFormElement | null;
    const field = document.getElementById('home-q') as HTMLInputElement | null;
    form?.addEventListener('submit', (e) => {
      if (!field) return;
      if (!field.value.trim()) { e.preventDefault(); field.focus(); return; }
      field.name = /[\u0370-\u03ff\u1f00-\u1fff]/.test(field.value) ? 'g' : 'q';
    });
  </script>

  <script>
    // Mobile-only collapse: tapping a shelf header toggles its body. On
    // desktop the buttons are pointer-events:none (see CSS), so these never
    // fire.
    const toggles: [string, string][] = [['.cat-toggle', '.cat']];
    for (const [btnSel, boxSel] of toggles) {
      for (const btn of document.querySelectorAll<HTMLButtonElement>(btnSel)) {
        btn.addEventListener('click', () => {
          const open = btn.closest(boxSel)!.toggleAttribute('data-open');
          btn.setAttribute('aria-expanded', String(open));
        });
      }
    }
  </script>
</body>
</html>
