---
import ThemeInit from '../components/ThemeInit.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Inscription from '../components/Inscription.astro';
import Pwa from '../components/Pwa.astro';
import Fonts from '../components/Fonts.astro';
import { jsonLdSafe } from '../lib/jsonld';
import '@shared/styles/global.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pageTitle = 'Page Not Found — Plato Reader';
const metaDescription =
  "The requested Plato Reader page could not be found. Return to the corpus or search Plato's Greek and English texts.";
const canonical = Astro.site ? new URL(`${base}/404/`, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(`${base}/og-default.png`, Astro.site).href : undefined;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: pageTitle,
  description: metaDescription,
  ...(canonical ? { url: canonical } : {}),
  isPartOf: { '@type': 'WebSite', name: 'The Plato Reader' },
};
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ThemeInit />
  <title>{pageTitle}</title>
  <meta name="description" content={metaDescription} />
  <meta name="robots" content="noindex,follow" />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:site_name" content="The Plato Reader" />
  {canonical && <meta property="og:url" content={canonical} />}
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={metaDescription} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  <script type="application/ld+json" set:html={jsonLdSafe(jsonLd)} />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="icon" href={`${base}/favicon.png`} type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} sizes="180x180" />
  <Fonts />
  <Pwa />
</head>
<body>
  <SiteNav />
  <main class="not-found">
    <p class="eyebrow">Plato</p>
    <figure class="goatstag">
      <Inscription text="ΑΝΑΜΝΗΣΙΣ" cols={3} accentRows={1} />
      <figcaption><span lang="grc">ἀνάμνησις</span> · recollection (<em>Meno</em> 82b–85b)</figcaption>
    </figure>
    <h1>Page not found</h1>
    <p class="lede">&ldquo;And how will you search for a page, Socrates, when you
      do not know at all what it is? Even if you should stumble upon it, how will
      you know it is the page, if you did not know it to begin with?&rdquo;
      &mdash; <em>Meno</em> 80d, more or less</p>
    <p class="lede">Try recollecting &mdash; you may have known this URL in a former life.</p>
    <div class="actions">
      <a class="btn-primary" href={`${base}/`}>Back to the corpus</a>
      <a class="btn-secondary" href={`${base}/search`}>Search</a>
    </div>
  </main>
  <SiteFooter />

  <style>
    body { background: var(--page-bg); color: var(--text); margin: 0; }
    .not-found {
      max-width: 36rem;
      margin: 0 auto;
      padding: clamp(3rem, 10vh, 6rem) 1.5rem 4rem;
      text-align: center;
    }
    .eyebrow {
      font-family: var(--font-caps);
      font-weight: 300;
      text-transform: uppercase;
      letter-spacing: .24em;
      font-size: .75rem;
      color: var(--accent);
      margin: 0 0 1.4rem;
    }
    h1 {
      font-family: var(--font-greek);
      font-weight: 400;
      font-size: clamp(2rem, 5vw, 2.6rem);
      color: var(--text);
      margin: 0 0 1rem;
    }
    .lede {
      font-family: var(--font-english);
      color: var(--text-mid);
      font-size: 1rem;
      line-height: 1.55;
      margin: 0 0 2rem;
    }
    /* ἀνάμνησις cut as a square, three letters by three — the Meno's lesson
       on recollection turns on a square. */
    .goatstag { margin: 0 0 1.6rem; --cell-w: 4.5rem; --cell-h: 5.25rem; --cell-fs: 4.25rem; display: grid; justify-items: center; }
    .goatstag figcaption {
      font-family: var(--font-greek);
      font-size: .95rem;
      color: var(--text-mid);
      margin-top: .5rem;
    }
    .actions { display: flex; gap: .75rem; justify-content: center; flex-wrap: wrap; }
    .btn-primary, .btn-secondary {
      text-decoration: none;
      font-family: var(--font-caps);
      font-weight: 300;
      font-size: .8125rem;
      letter-spacing: var(--caps-tracking);
      text-transform: uppercase;
      padding: .875rem 1.375rem;
      border: 1px solid var(--text);
    }
    .btn-primary { background: var(--text); color: var(--page-bg); }
    .btn-primary:hover { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
    .btn-secondary { background: none; color: var(--text); }
    .btn-secondary:hover { border-color: var(--accent); color: var(--accent); }
  </style>
</body>
</html>
