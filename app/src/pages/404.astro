---
import ThemeInit from '../components/ThemeInit.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Inscription from '../components/Inscription.astro';
import Pwa from '../components/Pwa.astro';
import Fonts from '../components/Fonts.astro';
import { jsonLdSafe } from '../lib/jsonld';
import '@shared/styles/global.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pageTitle = 'Page Not Found — Plato Reader';
const metaDescription =
  "The requested Plato Reader page could not be found. Return to the corpus or search Plato's Greek and English texts.";
const canonical = Astro.site ? new URL(`${base}/404/`, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(`${base}/og-default.png`, Astro.site).href : undefined;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: pageTitle,
  description: metaDescription,
  ...(canonical ? { url: canonical } : {}),
  isPartOf: { '@type': 'WebSite', name: 'The Plato Reader' },
};
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ThemeInit />
  <title>{pageTitle}</title>
  <meta name="description" content={metaDescription} />
  <meta name="robots" content="noindex,follow" />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:site_name" content="The Plato Reader" />
  {canonical && <meta property="og:url" content={canonical} />}
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={metaDescription} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  <script type="application/ld+json" set:html={jsonLdSafe(jsonLd)} />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="icon" href={`${base}/favicon.png`} type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} sizes="180x180" />
  <Fonts />
  <Pwa />
</head>
<body>
  <SiteNav />
  <main class="nf">
    <!-- The Meno's doubled square: the slave boy recollects that the square on
         the diagonal (blue) is twice the first. -->
    <figure class="nf-fig">
      <svg viewBox="0 0 200 200" width="220" height="220" fill="none" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="The doubled square from the Meno">
        <rect x="50" y="50" width="100" height="100" stroke="var(--text)" stroke-width="1.6" />
        <line x1="100" y1="50" x2="100" y2="150" stroke="var(--border)" stroke-width="1.2" />
        <line x1="50" y1="100" x2="150" y2="100" stroke="var(--border)" stroke-width="1.2" />
        <polygon points="100,50 150,100 100,150 50,100" stroke="var(--accent)" stroke-width="2" />
      </svg>
      <figcaption>Meno 82b–85b</figcaption>
    </figure>
    <div class="nf-text">
      <div class="xp-word" style="--n:9">
        <Inscription text="ΑΝΑΜΝΗΣΙΣ" cols={9} rows={1} accentRows={1} />
      </div>
      <h1 class="xp-h1">Page not found</h1>
      <blockquote>
        <p>&ldquo;And how will you search for a page, Socrates, when you do not
        know at all what it is? Even if you should stumble upon it, how will you
        know it is the page, if you did not know it to begin with?&rdquo;</p>
      </blockquote>
      <p class="src">Meno 80d, more or less</p>
      <p class="xp-lead">Try recollecting: you may have known this address in a former life.</p>
      <div class="actions">
        <a class="xp-btn" href={`${base}/`}>Back to the works</a>
        <a class="xp-btn o" href={`${base}/search`}>Search</a>
      </div>
    </div>
  </main>
  <SiteFooter />

  <style>
    .nf {
      display: grid;
      grid-template-columns: 16.25rem minmax(0, 35rem);
      gap: 4rem;
      align-items: center;
      padding: 3.5rem 3.5rem 4rem;
    }
    .nf-fig { margin: 0; }
    .nf-fig svg { display: block; max-width: 100%; height: auto; }
    .nf-fig figcaption {
      margin-top: 0.5rem;
      font-family: var(--font-caps);
      font-weight: 300;
      font-size: 0.75rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--text-mid);
    }
    .nf .xp-h1 { margin-top: 1.125rem; }
    blockquote { margin: 1rem 0 0; }
    blockquote p { margin: 0; font-size: 1.25rem; line-height: 1.55; font-style: italic; }
    .src {
      margin: 0.625rem 0 0;
      font-family: var(--font-caps);
      font-weight: 300;
      font-size: 0.75rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--text-mid);
    }
    .nf .xp-lead { margin-top: 1.125rem; }
    .actions { display: flex; flex-wrap: wrap; gap: 0.875rem; margin-top: 1.875rem; }
    @media (max-width: 680px) {
      .nf { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; padding: 1.5rem 1.25rem 2.5rem; }
      .nf-fig svg { width: 9rem; height: 9rem; }
      blockquote p { font-size: 1.125rem; }
    }
  </style>
</body>
</html>
