---
// The Greek Lexicon index at /lemma — a crawlable directory of every built lemma
// page, sorted alphabetically by transliteration. Doubles as the DefinedTermSet
// landing and an internal-link hub so the per-lemma pages get discovered.
import { readFileSync } from 'node:fs';
import ThemeInit from '../../components/ThemeInit.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import PageHead from '../../components/PageHead.astro';
import Pwa from '../../components/Pwa.astro';
import Fonts from '../../components/Fonts.astro';
import { jsonLdSafe } from '../../lib/jsonld';
import { greekFold } from '@shared/lib/search';
import '@shared/styles/global.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Read the popup manifest (lsjKey -> {slug, head, count}) for the full built set.
const manifest: Record<string, { slug: string; head: string; count: number }> = JSON.parse(
  readFileSync('public/data/lemmata.json', 'utf-8'),
);
// Each entry's first gloss, from its lemma file (the one its page shows).
const glossOf = (slug: string): string => {
  try {
    const j = JSON.parse(readFileSync(`public/data/lemmata/${slug}.json`, 'utf-8'));
    return (j.glosses ?? [])[0] ?? '';
  } catch {
    return '';
  }
};
// `fold` folds the polytonic head to Beta-Code letters (accent-stripped) so the
// client filter can match it against either Greek or Beta Code input with the
// same greekFold — see the inline script below.
const entries = Object.values(manifest)
  .map((e) => ({ ...e, fold: greekFold(e.head), gloss: glossOf(e.slug) }))
  .sort((a, b) => a.slug.localeCompare(b.slug));

const pageTitle = "Lexicon of Plato's Greek — Word Frequency & Concordance";
const metaDescription =
  `A growing lexicon of Plato's Greek vocabulary: ${entries.length} key terms with` +
  ` LSJ definitions, corpus-wide frequency counts, and every occurrence linked to the` +
  ` parallel Greek–English text with Stephanus citation.`;
const canonical = Astro.site ? new URL(`${base}/lemma/`, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(`${base}/og-default.png`, Astro.site).href : undefined;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  name: "Lexicon of Plato's Greek",
  description: metaDescription,
  ...(canonical ? { url: canonical } : {}),
  hasDefinedTerm: entries.slice(0, 100).map((e) => ({
    '@type': 'DefinedTerm', name: e.head, inLanguage: 'grc',
    ...(canonical ? { url: new URL(`${base}/lemma/${e.slug}/`, Astro.site!).href } : {}),
  })),
};
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ThemeInit />
  <title>{pageTitle}</title>
  <meta name="description" content={metaDescription} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={metaDescription} />
  {canonical && <meta property="og:url" content={canonical} />}
  <meta property="og:site_name" content="The Plato Reader" />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={metaDescription} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  <script type="application/ld+json" set:html={jsonLdSafe(jsonLd)} />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="icon" href={`${base}/favicon.png`} type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} sizes="180x180" />
  <Fonts />
  <style>
    /* The filter stays in view under the top bar while the list scrolls. */
    .lxi-filter { position: sticky; top: 4rem; z-index: 5; padding-top: 0.5rem; background: var(--page-bg); }
    .lxi-empty { color: var(--text-mid); font-size: 1.0625rem; margin: 1rem 0; }
    /* The entries: ruled rows in four columns, headword and count on one line,
       the gloss beneath. */
    .lx {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
      column-gap: 2rem;
      margin: 1.625rem 0 0;
      padding: 0;
      list-style: none;
      border-top: 1px solid var(--text);
    }
    .lx a {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: baseline;
      gap: 0.25rem 0.625rem;
      padding: 0.6875rem 0;
      border-bottom: 1px solid var(--border);
      color: var(--text);
      text-decoration: none;
    }
    .lx a:hover .hw { color: var(--accent); }
    .lx .hw { font-family: var(--font-greek); font-size: 1.3125rem; }
    .lx .ct { font-family: var(--font-caps); font-weight: 300; font-size: 0.75rem; letter-spacing: 0.04em; font-variant-numeric: tabular-nums; color: var(--text-mid); }
    .lx .gl { grid-column: 1 / -1; font-size: 0.9375rem; font-style: italic; line-height: 1.35; color: var(--text-mid); }
    @media (max-width: 680px) {
      .lxi-filter { top: 3.25rem; }
      .lx { margin-top: 0.875rem; }
      .lx .hw { font-size: 1.1875rem; }
    }
  </style>
  <Pwa />
</head>
<body>
  <SiteNav current="lexicon" />
  <main>
    <PageHead word="λεξικόν" label="Greek lexicon">
      <h1 class="xp-h1">Lexicon of Plato’s Greek</h1>
      <p class="xp-lead">
        Key words with their dictionary sense, how often each appears across the
        corpus, and every occurrence linked to the parallel Greek–English text.
        A concordance you can read.
      </p>
    </PageHead>
    <div class="xp-body">
      <div class="lxi-filter">
        <label class="xp-field">
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.2-4.2"/></svg>
          <input
            type="search"
            id="lxi-input"
            placeholder="Filter: type Greek (οὐσ) or Beta Code (ous)"
            autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false"
            aria-label="Filter the lexicon by Greek or Beta Code"
          />
        </label>
      </div>
      <p class="xp-meta"><span id="lxi-count" aria-live="polite" data-total={entries.length}>{entries.length.toLocaleString()} key words</span></p>
      <ul class="lx" id="lxi-grid">
        {entries.map((e) => (
          <li data-fold={e.fold}>
            <a href={`${base}/lemma/${e.slug}/`}>
              <span class="hw" lang="grc">{e.head}</span>
              <span class="ct">{e.count.toLocaleString()}</span>
              {e.gloss && <span class="gl">{e.gloss}</span>}
            </a>
          </li>
        ))}
      </ul>
      <p class="lxi-empty" id="lxi-empty" hidden>No entries match. Try the dictionary form (e.g. <span lang="grc">οὐσία</span>, not an inflected form).</p>
    </div>
  </main>
  <SiteFooter />

  <script>
    // Client filter: fold both the built-in `data-fold` (already Beta-folded from
    // the polytonic head at build) and the user's query with the SAME greekFold,
    // so typing polytonic Greek OR Beta Code both match. Prefix match, like a
    // dictionary lookup.
    const GREEK_BETA: Record<string, string> = {
      α:'a',β:'b',γ:'g',δ:'d',ε:'e',ζ:'z',η:'h',θ:'q',ι:'i',κ:'k',
      λ:'l',μ:'m',ν:'n',ξ:'c',ο:'o',π:'p',ρ:'r',σ:'s',ς:'s',τ:'t',
      υ:'u',φ:'f',χ:'x',ψ:'y',ω:'w',ϝ:'v',
    };
    const fold = (s: string) => {
      let out = '';
      for (const ch of s.normalize('NFD')) {
        const lower = ch.toLowerCase();
        if (GREEK_BETA[lower]) out += GREEK_BETA[lower];
        else if (lower >= 'a' && lower <= 'z') out += lower;
      }
      return out;
    };
    const input = document.getElementById('lxi-input') as HTMLInputElement | null;
    const grid = document.getElementById('lxi-grid');
    const countEl = document.getElementById('lxi-count');
    const emptyEl = document.getElementById('lxi-empty');
    if (input && grid) {
      const items = Array.from(grid.querySelectorAll<HTMLLIElement>('li'));
      const total = items.length;
      const apply = () => {
        const q = fold(input.value.trim());
        let shown = 0;
        for (const li of items) {
          const hit = !q || (li.dataset.fold ?? '').startsWith(q);
          li.hidden = !hit;
          if (hit) shown++;
        }
        if (countEl) countEl.textContent = q
          ? `${shown.toLocaleString()} of ${total.toLocaleString()} key words`
          : `${total.toLocaleString()} key words`;
        if (emptyEl) emptyEl.hidden = shown !== 0;
      };
      input.addEventListener('input', apply);
    }
  </script>
</body>
</html>
